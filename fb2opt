def _cpu_count() -> int:
    """Usable cores, at least 1. Never raises."""
    try:
        return max(1, os.cpu_count() or 1)
    except (NotImplementedError, AttributeError, TypeError, OSError):
        return 1


def have_pil() -> bool:
    """Pillow available (lossy encoder)."""
    return Image is not None


def have_ffmpeg() -> bool:
    """ffmpeg available (lossy quality metric)."""
    return shutil.which("ffmpeg") is not None


def have_oxipng() -> bool:
    """oxipng available (PNG reductions chained before ect)."""
    return shutil.which("oxipng") is not None


def have_jpegtran() -> bool:
    """jpegtran available (JPEG entropy finish after ect)."""
    return shutil.which("jpegtran") is not None


_ECT_REUSE_OK: bool | None = None


def _ect_reuse_ok() -> bool:
    """Installed ect understands --reuse (probed once, cached). Never raises."""
    global _ECT_REUSE_OK
    if _ECT_REUSE_OK is not None:
        return _ECT_REUSE_OK
    try:
        done = subprocess.run(["ect", "-help"], stdout=subprocess.PIPE,
                              stderr=subprocess.STDOUT, timeout=30)
    except (OSError, subprocess.SubprocessError):
        _ECT_REUSE_OK = False
        return False
    try:
        out = bytes(done.stdout or b"")
    except (TypeError, AttributeError):
        _ECT_REUSE_OK = False
        return False
    _ECT_REUSE_OK = b"--reuse" in out
    return _ECT_REUSE_OK


def _lossy_tools_ok() -> bool:
    """Everything --lossy needs: Pillow to encode, ffmpeg to measure."""
    return have_pil() and have_ffmpeg()


_DEP_CHECKS = {
    "ect": lambda: shutil.which("ect") is not None,
    "oxipng": lambda: have_oxipng(),
    "jpegtran": lambda: have_jpegtran(),
    "Pillow": lambda: have_pil(),
    "ffmpeg": lambda: have_ffmpeg(),
}


def dep_status() -> list[tuple[str, str, bool]]:
    """External dependency status: [(name, role, found)]."""
    return [(name, role, _DEP_CHECKS.get(name, lambda: False)())
            for name, role in DEPS]


def format_deps() -> str:
    """Dependency text block for the hint."""
    lines = ["Dependencies:"]
    for name, role, found in dep_status():
        mark = "found" if found else "NOT FOUND"
        lines.append(f"  {name:<10} {mark:<10} {role}")
    return "\n".join(lines)


