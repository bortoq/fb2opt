#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""fb2opt — lossless optimization of FB2 books (.fb2.zip).

One file, three modes:
  optimize (default) — recompress images (PNG/JPEG) and XML, repack the ZIP;
  --extract          — pull images out of a book;
  --pack             — put images from a folder back into a book.

Replacement rule:
  the new file replaces the old one ONLY if (old_size - new_size) > 0,
  otherwise the original is left untouched.

The result line shows total saved bytes on disk, followed — in the same
brackets — by the unpacked-FB2 breakdown by type: xml (markup), png, jpg.
"""

from __future__ import annotations

import argparse
import base64
import binascii
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import uuid
import zipfile
from dataclasses import dataclass, field


# --------------------------------------------------------------------------
# Constants
# --------------------------------------------------------------------------

BINARY_RE = re.compile(r"<binary\b([^>]*)>(.*?)</binary\s*>",
                       re.DOTALL | re.IGNORECASE)
ID_RE = re.compile(r"""id\s*=\s*["']([^"']+)["']""", re.IGNORECASE)
COMMENT_RE = re.compile(r"<!--.*?-->", re.DOTALL)
CDATA_RE = re.compile(r"<!\[CDATA\[.*?\]\]>", re.DOTALL)
# Whitespace strictly between two tags (element-only content). Never touches text.
GAP_RE = re.compile(r"(<[^<>]*>)[ \t\r\n]+(<[^<>]*>)")
# Gaps between two of these render as a space: collapse to one space,
# everywhere else the gap is removed entirely.
INLINE_TAGS = frozenset({"a", "code", "emphasis", "image", "strikethrough",
                         "strong", "style", "sub", "sup"})

DEPS: tuple[tuple[str, str], ...] = (
    ("ect", "lossless PNG / JPEG / ZIP compression, metadata stripping"),
)

PNG_MAGIC = b"\x89PNG\r\n\x1a\n"
JPEG_MAGIC = b"\xff\xd8\xff"
PNG_TRAILER = b"\x00\x00\x00\x00IEND\xaeB`\x82"
JPEG_TRAILER = b"\xff\xd9"

TOOL_TIMEOUT = 600

VERSION = "4.1"


class Fb2OptError(Exception):
    """Expected per-file error (printed, does not stop the batch)."""


# --------------------------------------------------------------------------
# Stats
# --------------------------------------------------------------------------

@dataclass
class Fb2Stats:
    pics: int = 0
    png_saved: int = 0
    jpg_saved: int = 0
    other_saved: int = 0
    xml_saved: int = 0
    skipped: int = 0  # binary blocks left alone (no id / broken base64)

    def add(self, other: "Fb2Stats") -> None:
        self.pics += other.pics
        self.png_saved += other.png_saved
        self.jpg_saved += other.jpg_saved
        self.other_saved += other.other_saved
        self.xml_saved += other.xml_saved
        self.skipped += other.skipped

    def breakdown(self) -> str:
        # Show only types with nonzero savings; zeros carry no information.
        parts = []
        for label, value in (("xml", self.xml_saved),
                             ("png", self.png_saved),
                             ("jpg", self.jpg_saved),
                             ("other", self.other_saved)):
            if value:
                parts.append(f"{label}: {value}")
        if not parts:
            parts.append("repack only")
        return ", ".join(parts)


@dataclass
class _Image:
    idx: int
    img_id: str
    kind: str            # png | jpg | gif | other
    raw: bytes           # original image bytes
    orig_b64_len: int    # base64 body length in the source file (as is)
    attrs: str           # attributes of the <binary ...> tag
    orig_body: str = ""   # original base64 body (for byte-exact keep)


# --------------------------------------------------------------------------
# Small pure helpers (guard clauses first)
# --------------------------------------------------------------------------

def sanitize_filename(name: object) -> str:
    """Turn an image id into a safe file name."""
    if not isinstance(name, str) or not name:
        return "img"
    safe = re.sub(r'[\\/*?:"\n<>|]', "_", name).strip()
    return safe or "img"


def run_tool(cmd: list[str]) -> bool:
    """Run an external optimizer. Never raises."""
    if not cmd:
        return False
    try:
        done = subprocess.run(cmd, stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=TOOL_TIMEOUT)
    except (OSError, subprocess.SubprocessError):
        return False
    return done.returncode == 0


def detect_kind(raw: bytes, attrs: str) -> str:
    """Detect the image type: magic bytes first, then the tag hint."""
    if not raw:
        return "other"
    if raw.startswith(PNG_MAGIC):
        return "png"
    if raw.startswith(JPEG_MAGIC):
        return "jpg"
    if raw.startswith((b"GIF87a", b"GIF89a")):
        return "gif"
    hint = (attrs or "").lower()
    if "png" in hint:
        return "png"
    if "jpg" in hint or "jpeg" in hint:
        return "jpg"
    if "gif" in hint:
        return "gif"
    return "other"


def decode_body(body: str) -> bytes | None:
    """Decode a <binary> base64 body. None — broken block, keep it as is."""
    if body is None:
        return None
    try:
        cleaned = "".join(body.split())
    except Exception:
        return None
    if not cleaned:
        return None
    try:
        data = base64.b64decode(cleaned)
    except (binascii.Error, ValueError):
        return None
    return data or None


def encode_body(raw: bytes) -> str:
    """Encode image bytes as canonical base64 (76-char lines)."""
    b64 = base64.b64encode(raw).decode("ascii")
    return "\n" + "\n".join(b64[i:i + 76] for i in range(0, len(b64), 76)) + "\n"


def _tag_name(tag: str) -> str:
    """Tag name of `<...>` without brackets, slash or attributes ("" if none)."""
    if not tag:
        return ""
    match = re.match(r"</?\s*([A-Za-z][\w:.-]*)", tag)
    if not match:
        return ""
    return match.group(1).split(":")[-1].lower()  # fb:emphasis counts as emphasis


def _gap_replace(match: re.Match) -> str:
    """Collapse one inter-tag gap: one space between two inline tags, else nothing."""
    left, right = match.group(1), match.group(2)
    if _tag_name(left) in INLINE_TAGS and _tag_name(right) in INLINE_TAGS:
        return f"{left} {right}"
    return f"{left}{right}"


def minify_skeleton(text: str) -> str:
    """Minify the XML skeleton without touching rendered text.

    Only rendering-neutral transforms:
      comments (outside CDATA) are dropped;
      whitespace strictly between two tags collapses — one space stays
      between two inline tags, everywhere else the gap is removed
      (repeated to a fixpoint, so chained gaps all collapse).
    CDATA sections ride through masked and come back byte-exact.
    """
    if not text:
        return text
    token = uuid.uuid4().hex
    cdata: list[str] = []

    def _mask(match: re.Match) -> str:
        cdata.append(match.group(0))
        return f"__FB2OPT_CDATA_{token}_{len(cdata) - 1}__"

    masked = CDATA_RE.sub(_mask, text)
    masked = COMMENT_RE.sub("", masked)
    # One pass eats every second gap (consumed tags), so run to fixpoint.
    previous = None
    while masked != previous:
        previous = masked
        masked = GAP_RE.sub(_gap_replace, masked)
    for idx, section in enumerate(cdata):
        masked = masked.replace(f"__FB2OPT_CDATA_{token}_{idx}__", section, 1)
    return masked


def decode_fb2_payload(payload: bytes) -> tuple[str, str]:
    """Decode FB2 bytes to text. Returns (text, encoding)."""
    if payload is None:
        raise Fb2OptError("empty FB2 data")
    try:
        return payload.decode("utf-8"), "utf-8"
    except UnicodeDecodeError:
        pass
    try:
        return payload.decode("cp1251"), "cp1251"
    except UnicodeDecodeError as exc:
        raise Fb2OptError(f"unknown FB2 encoding: {exc}") from exc


def unique_path(path: str) -> str:
    """Pick a free file name (adds _2, _3, ... on collision)."""
    if not os.path.exists(path):
        return path
    stem, ext = os.path.splitext(path)
    n = 2
    while os.path.exists(f"{stem}_{n}{ext}"):
        n += 1
    return f"{stem}_{n}{ext}"


# --------------------------------------------------------------------------
# Dependencies
# --------------------------------------------------------------------------

def dep_status() -> list[tuple[str, str, bool]]:
    """External dependency status: [(name, role, found)]."""
    return [(name, role, shutil.which(name) is not None) for name, role in DEPS]


def format_deps() -> str:
    """Dependency text block for the hint."""
    lines = ["Dependencies:"]
    for name, role, found in dep_status():
        mark = "found" if found else "NOT FOUND"
        lines.append(f"  {name:<10} {mark:<10} {role}")
    return "\n".join(lines)


def short_hint() -> str:
    """Short hint for a run with no arguments."""
    return (
        "fb2opt — lossless optimization of FB2 books (.fb2.zip).\n"
        "Usage:\n"
        "  fb2opt BOOK.fb2.zip [...]         optimize (replace only if smaller)\n"
        "  fb2opt -r LIBRARY [...]           walk folders, optimize every .fb2.zip\n"
        "  fb2opt BOOK.fb2 [...]             pack into .fb2.zip next to it\n"
        "  fb2opt --extract SRC [--dir OUT]  pull images (SRC: file or folder)\n"
        "  fb2opt --pack BOOK.fb2 [--dir D]  put images from folder D into the book\n"
        "  fb2opt --deps                     dependency status only\n"
        "  fb2opt --version                  show version\n"
        "  fb2opt -h | --help                full help\n"
        f"{format_deps()}\n"
        "The original is replaced only if (old - new) > 0."
    )


# --------------------------------------------------------------------------
# Image optimization
# --------------------------------------------------------------------------

def _looks_complete(kind: str, data: bytes) -> bool:
    """Sanity check: same header magic and a proper end marker."""
    if not data:
        return False
    if kind == "png":
        return data.startswith(PNG_MAGIC) and data.endswith(PNG_TRAILER)
    if kind == "jpg":
        return data.startswith(JPEG_MAGIC) and data.endswith(JPEG_TRAILER)
    return True


def optimize_images(images: list[_Image], workdir: str,
                    have_ect: bool) -> dict[int, bytes]:
    """Run images through external optimizers.

    Returns {idx: final_bytes}. Each image keeps the smaller of
    (original, optimized) — a single file never grows.
    """
    result: dict[int, bytes] = {}
    if not images:
        return result
    os.makedirs(workdir, exist_ok=True)
    for img in images:
        if not img.raw:
            result[img.idx] = img.raw
            continue
        if img.kind not in ("png", "jpg") or not have_ect:
            result[img.idx] = img.raw  # gif/other need no tool; without ect keep as is
            continue
        tmp = os.path.join(workdir, f"{img.idx:04d}_{sanitize_filename(img.img_id)}"
                                    f".{img.kind if img.kind in ('png', 'jpg') else 'bin'}")
        try:
            with open(tmp, "wb") as fh:
                fh.write(img.raw)
        except OSError:
            result[img.idx] = img.raw
            continue
        if img.kind == "png":
            run_tool(["ect", "-9", tmp])
        else:
            run_tool(["ect", "-9", "-strip", "-progressive", tmp])
        try:
            with open(tmp, "rb") as fh:
                optimized = fh.read()
        except OSError:
            optimized = img.raw
        # Guard against pessimization: keep the smaller.
        if not 0 < len(optimized) < len(img.raw):
            result[img.idx] = img.raw
            continue
        # The optimizer must return a complete image, not a truncated one.
        if not _looks_complete(img.kind, optimized):
            print(f"[warning] {img.img_id}: optimizer output failed validation, "
                  f"kept original", file=sys.stderr)
            result[img.idx] = img.raw
            continue
        result[img.idx] = optimized
        try:
            os.unlink(tmp)
        except OSError:
            pass
    return result


# --------------------------------------------------------------------------
# Optimizing one FB2 document (in memory)
# --------------------------------------------------------------------------

def optimize_fb2_payload(payload: bytes, workdir: str,
                         have_ect: bool) -> tuple[bytes, Fb2Stats]:
    """Optimize the bytes of one .fb2. Returns (new_bytes, stats).

    The breakdown is exact at unpacked-FB2 level:
      png/jpg/other — base64 body delta of images of that type;
      xml — the rest of the total delta (comments, gaps between tags).
    The breakdown sums to the unpacked FB2 delta.
    """
    if payload is None:
        raise Fb2OptError("empty FB2 data")
    text, encoding = decode_fb2_payload(payload)
    matches = list(BINARY_RE.finditer(text))

    images: list[_Image] = []
    skeleton_parts: list[str] = []
    skipped = 0
    token = uuid.uuid4().hex  # unique per document: literal text can never collide
    last = 0
    for idx, match in enumerate(matches):
        attrs, body = match.group(1), match.group(2)
        id_match = ID_RE.search(attrs or "")
        if not id_match:
            skipped += 1
            continue  # block without id — leave fully alone
        raw = decode_body(body)
        if raw is None:
            skipped += 1
            continue  # broken base64 — keep the block as is
        img_id = id_match.group(1)
        kind = detect_kind(raw, attrs or "")
        images.append(_Image(idx=idx, img_id=img_id, kind=kind,
                             raw=raw, orig_b64_len=len(body), attrs=attrs,
                             orig_body=body))
        placeholder = f"__FB2OPT_{token}_{idx}__"
        skeleton_parts.append(text[last:match.start()])
        skeleton_parts.append(f"<binary{attrs}>{placeholder}</binary>")
        last = match.end()
    skeleton_parts.append(text[last:])
    skeleton = "".join(skeleton_parts)

    optimized = optimize_images(images, workdir, have_ect)

    stats = Fb2Stats(pics=len(images), skipped=skipped)
    blocks: dict[int, str] = {}
    for img in images:
        final = optimized.get(img.idx, img.raw)
        if final == img.raw:
            # The skeleton already holds the tags around the placeholder: swap the body only.
            # Original body = byte-exact same block, delta 0.
            blocks[img.idx] = img.orig_body
            continue
        new_body = encode_body(final)
        blocks[img.idx] = new_body
        delta = img.orig_b64_len - len(new_body)
        if img.kind == "png":
            stats.png_saved += delta
        elif img.kind == "jpg":
            stats.jpg_saved += delta
        else:
            stats.other_saved += delta

    new_skeleton = minify_skeleton(skeleton)
    for img in images:
        new_skeleton = new_skeleton.replace(f"__FB2OPT_{token}_{img.idx}__",
                                            blocks[img.idx], 1)
    try:
        new_payload = new_skeleton.encode(encoding)
    except (UnicodeEncodeError, LookupError) as exc:
        raise Fb2OptError(f"failed to encode the result ({encoding}): {exc}") from exc

    total_delta = len(payload) - len(new_payload)
    img_delta = stats.png_saved + stats.jpg_saved + stats.other_saved
    stats.xml_saved = total_delta - img_delta
    return new_payload, stats


# --------------------------------------------------------------------------
# Writing the result under the "replace only if smaller" rule
# --------------------------------------------------------------------------

def _clone_info(info: zipfile.ZipInfo, compress_type: int | None = None
                ) -> zipfile.ZipInfo:
    """Copy a ZipInfo, optionally overriding the compression method."""
    ni = zipfile.ZipInfo(filename=info.filename, date_time=info.date_time)
    ni.compress_type = info.compress_type if compress_type is None else compress_type
    ni.comment = info.comment
    ni.extra = info.extra
    ni.internal_attr = info.internal_attr
    ni.external_attr = info.external_attr
    ni.create_system = info.create_system
    ni.create_version = info.create_version
    ni.extract_version = info.extract_version
    ni.flag_bits = info.flag_bits
    ni.volume = info.volume
    return ni


def _drop_tmp(tmp_path: str, registry: list[str]) -> None:
    """Remove a temp file and forget it. Never raises.

    Safety rail: only candidates created by _write_candidate
    (".fb2opt-*.zip" next to the target) are ever deleted here,
    so a book can never be removed through this path by mistake.
    """
    if not isinstance(tmp_path, str) or not os.path.basename(tmp_path).startswith(".fb2opt-"):
        try:
            registry.remove(tmp_path)
        except ValueError:
            pass
        print(f"[warning] refusing to delete a non-temp file: {tmp_path}",
              file=sys.stderr)
        return
    try:
        os.unlink(tmp_path)
    except OSError:
        pass
    try:
        registry.remove(tmp_path)
    except ValueError:
        pass


def _find_vanished(before: dict[str, bool]) -> list[str]:
    """Return input paths that existed before the batch but are gone now."""
    if not before:
        return []
    return [path for path, existed in before.items()
            if existed and not os.path.lexists(path)]


def _sweep_temps(registry: list[str]) -> None:
    """Best-effort cleanup of leftover temp files (e.g. after Ctrl+C)."""
    for tmp_path in list(registry):
        _drop_tmp(tmp_path, registry)


def _umask() -> int:
    """Current umask without changing it."""
    mask = os.umask(0)
    os.umask(mask)
    return mask


def _fresh_info(arcname: str, src_path: str) -> zipfile.ZipInfo:
    """ZipInfo for a freshly packed file: source mtime, sane permissions."""
    try:
        mtime = os.path.getmtime(src_path)
    except OSError:
        mtime = time.time()
    info = zipfile.ZipInfo(filename=arcname, date_time=time.localtime(mtime)[:6])
    info.compress_type = zipfile.ZIP_DEFLATED
    info.external_attr = (0o644 & ~_umask()) << 16
    return info


def _write_candidate(entries: list[tuple[zipfile.ZipInfo, bytes]],
                     archive_comment: bytes, base_dir: str,
                     have_ect: bool, registry: list[str]) -> str:
    """Repack entries into a temp ZIP next to the target. Returns its path."""
    try:
        handle, tmp_path = tempfile.mkstemp(dir=base_dir, prefix=".fb2opt-",
                                            suffix=".zip")
        os.close(handle)
    except OSError as exc:
        raise Fb2OptError(f"no write access to {base_dir}: {exc}") from exc
    registry.append(tmp_path)
    try:
        with zipfile.ZipFile(tmp_path, "w", zipfile.ZIP_DEFLATED,
                              compresslevel=9) as zout:
            for info, data in entries:
                zout.writestr(info, data)
            zout.comment = archive_comment
    except OSError as exc:
        _drop_tmp(tmp_path, registry)
        raise Fb2OptError(f"failed to pack: {exc}") from exc
    # ect -zip strips comments, so member comments are kept by skipping
    # the ect pass for such archives (rare); the archive comment is cheap
    # to restore afterwards.
    if have_ect and not any(info.comment for info, _ in entries):
        run_tool(["ect", "-9", "-zip", tmp_path])
        _verify_candidate(tmp_path, [info.filename for info, _ in entries],
                          registry)
    if archive_comment:
        try:
            with zipfile.ZipFile(tmp_path, "a") as zfix:
                zfix.comment = archive_comment
        except OSError:
            pass
    return tmp_path


def _verify_candidate(tmp_path: str, expected_names: list[str],
                      registry: list[str]) -> None:
    """Check the archive an external optimizer just touched.

    A broken/truncated candidate must never replace the original.
    """
    try:
        with zipfile.ZipFile(tmp_path, "r") as check:
            bad = check.testzip()
            names = check.namelist()
    except zipfile.BadZipFile as exc:
        _drop_tmp(tmp_path, registry)
        raise Fb2OptError(f"optimizer broke the archive, kept original: {exc}") from exc
    if bad is not None or sorted(names) != sorted(expected_names):
        _drop_tmp(tmp_path, registry)
        raise Fb2OptError(f"optimizer broke the archive (bad member: {bad}), "
                          f"kept original")


def _warn_skipped(name: str, stats: Fb2Stats) -> None:
    """Report binary blocks that were left alone (stderr, result line untouched)."""
    if stats.skipped:
        print(f"[warning] {name}: skipped {stats.skipped} bad <binary> blocks "
              f"(no id or broken base64)", file=sys.stderr)


def _place_if_smaller(tmp_path: str, final_path: str, old_size: int,
                       registry: list[str]) -> tuple[bool, int]:
    """Atomically swap final_path with a temp file, only if it is smaller.

    Returns (replaced, new_size). The temp file always goes away:
    it either moves into place or is deleted.
    """
    if not os.path.isfile(tmp_path):
        raise Fb2OptError("temp file is gone")
    new_size = os.path.getsize(tmp_path)
    if new_size <= 0:
        _drop_tmp(tmp_path, registry)
        raise Fb2OptError("refusing to install an empty file, kept original")
    saved = old_size - new_size
    if saved <= 0:
        _drop_tmp(tmp_path, registry)
        return False, new_size
    try:
        if os.path.exists(final_path):
            shutil.copymode(final_path, tmp_path)
        os.replace(tmp_path, final_path)
    except OSError as exc:
        _drop_tmp(tmp_path, registry)
        raise Fb2OptError(f"failed to write the result: {exc}") from exc
    try:
        actual = os.path.getsize(final_path)
    except OSError as exc:
        raise Fb2OptError(f"result vanished right after install: {exc}") from exc
    if actual != new_size:
        raise Fb2OptError(f"result size mismatch after install "
                          f"(expected {new_size}, got {actual})")
    try:
        registry.remove(tmp_path)
    except ValueError:
        pass
    return True, new_size


def optimize_zip_file(path: str, tmp_root: str, have_ect: bool,
                       registry: list[str]) -> tuple[int, str]:
    """Optimize a .zip archive in place (when it pays off). Returns (saved, line)."""
    if not os.path.isfile(path):
        raise Fb2OptError("file not found")
    name = os.path.basename(path)
    try:
        old_size = os.path.getsize(path)
    except OSError as exc:
        raise Fb2OptError(f"failed to read the size: {exc}") from exc
    try:
        with zipfile.ZipFile(path, "r") as zin:
            archive_comment = zin.comment
            members = [(info, zin.read(info.filename)) for info in zin.infolist()]
    except zipfile.BadZipFile as exc:
        raise Fb2OptError(f"broken ZIP: {exc}") from exc
    except OSError as exc:
        raise Fb2OptError(f"failed to unpack: {exc}") from exc

    img_workdir = os.path.join(tmp_root, "img")
    stats = Fb2Stats()
    entries: list[tuple[zipfile.ZipInfo, bytes]] = []
    fb2_count = 0
    for info, data in members:
        if info.is_dir():
            entries.append((_clone_info(info), data))
            continue
        if info.filename.lower().endswith(".fb2"):
            try:
                new_data, member_stats = optimize_fb2_payload(
                    data, img_workdir, have_ect)
            except Fb2OptError as exc:
                raise Fb2OptError(f"{info.filename}: {exc}") from exc
            stats.add(member_stats)
            fb2_count += 1
            entries.append((_clone_info(info, zipfile.ZIP_DEFLATED), new_data))
        else:
            entries.append((_clone_info(info), data))  # foreign files — byte for byte
    if fb2_count == 0:
        raise Fb2OptError("no .fb2 in the archive")

    base_dir = os.path.dirname(os.path.abspath(path))
    tmp_path = _write_candidate(entries, archive_comment, base_dir,
                                have_ect, registry)

    replaced, _ = _place_if_smaller(tmp_path, os.path.abspath(path), old_size,
                                    registry)
    _warn_skipped(name, stats)
    if not replaced:
        return 0, f"{name}: already optimal"
    saved = old_size - os.path.getsize(os.path.abspath(path))
    return saved, f"{name}: saved {saved} bytes ({stats.breakdown()})"


def optimize_fb2_file(path: str, tmp_root: str, have_ect: bool,
                       registry: list[str]) -> tuple[int, str]:
    """Pack a raw .fb2 into a sibling .fb2.zip (under the "write only if smaller" rule)."""
    if not os.path.isfile(path):
        raise Fb2OptError("file not found")
    name = os.path.basename(path)
    abs_path = os.path.abspath(path)
    try:
        with open(abs_path, "rb") as fh:
            payload = fh.read()
    except OSError as exc:
        raise Fb2OptError(f"failed to read: {exc}") from exc

    img_workdir = os.path.join(tmp_root, "img")
    new_payload, stats = optimize_fb2_payload(payload, img_workdir, have_ect)

    target = abs_path + ".zip"
    entries = [(_fresh_info(os.path.basename(abs_path), abs_path), new_payload)]
    tmp_path = _write_candidate(entries, b"", os.path.dirname(abs_path),
                                have_ect, registry)
    try:
        os.chmod(tmp_path, 0o666 & ~_umask())  # fresh files: normal perms, not 0600
    except OSError:
        pass

    try:
        new_size = os.path.getsize(tmp_path)
    except OSError as exc:
        _drop_tmp(tmp_path, registry)
        raise Fb2OptError(f"temp file is gone: {exc}") from exc

    if os.path.exists(target):
        try:
            old_size = os.path.getsize(target)
        except OSError as exc:
            _drop_tmp(tmp_path, registry)
            raise Fb2OptError(f"failed to read {target}: {exc}") from exc
        replaced, _ = _place_if_smaller(tmp_path, target, old_size, registry)
        _warn_skipped(name, stats)
        if not replaced:
            return 0, f"{name}: already optimal"
        return old_size - new_size, (f"{name}: saved {old_size - new_size} bytes "
                                     f"({stats.breakdown()})")

    old_size = len(payload)
    if new_size >= old_size:
        _drop_tmp(tmp_path, registry)
        _warn_skipped(name, stats)
        return 0, (f"{name}: saved 0 bytes "
                   f"(compressed copy is bigger, not created)")
    try:
        os.replace(tmp_path, target)
    except OSError as exc:
        _drop_tmp(tmp_path, registry)
        raise Fb2OptError(f"failed to write {target}: {exc}") from exc
    try:
        registry.remove(tmp_path)
    except ValueError:
        pass
    _warn_skipped(name, stats)
    return old_size - new_size, (f"{name}: saved {old_size - new_size} bytes "
                                 f"({stats.breakdown()}) → {os.path.basename(target)}")


def _optimize_one(path: str, tmp_root: str, have_ect: bool,
                   registry: list[str]) -> tuple[int, str]:
    """Optimize a single file; errors come as Fb2OptError."""
    if not isinstance(path, str) or not path:
        raise Fb2OptError("empty file name")
    if os.path.islink(path):
        return 0, f"{os.path.basename(path)}: skipped (symlink, left untouched)"
    if os.path.isdir(path):
        raise Fb2OptError("is a directory (use -r to walk it)")
    lowered = path.lower()
    per_file_tmp = tempfile.mkdtemp(dir=tmp_root)
    if lowered.endswith(".zip"):
        return optimize_zip_file(path, per_file_tmp, have_ect, registry)
    if lowered.endswith(".fb2"):
        return optimize_fb2_file(path, per_file_tmp, have_ect, registry)
    raise Fb2OptError("need .fb2 or .zip")


# --------------------------------------------------------------------------
# --extract mode
# --------------------------------------------------------------------------

def _iter_fb2_payloads(sources: list[str]):
    """Yield (source_name, book_name, fb2_bytes) from files/folders."""
    if not sources:
        return
    for src in sources:
        if not isinstance(src, str) or not src or not os.path.exists(src):
            print(f"[error] source not found: {src}", file=sys.stderr)
            continue
        if os.path.isdir(src):
            for root, _, files in os.walk(src):
                for fn in sorted(files):
                    if fn.lower().endswith((".fb2", ".zip")):
                        yield from _payloads_from_file(os.path.join(root, fn))
        else:
            yield from _payloads_from_file(src)


def _payloads_from_file(path: str):
    """FB2 bytes from one file (.fb2 directly, .zip — every nested .fb2)."""
    lowered = path.lower()
    if lowered.endswith(".fb2"):
        try:
            with open(path, "rb") as fh:
                yield path, os.path.basename(path), fh.read()
        except OSError as exc:
            print(f"[error] {path}: cannot read: {exc}", file=sys.stderr)
        return
    if lowered.endswith(".zip"):
        try:
            with zipfile.ZipFile(path, "r") as zin:
                members = [(info.filename, zin.read(info.filename))
                           for info in zin.infolist()
                           if not info.is_dir() and info.filename.lower().endswith(".fb2")]
        except Exception as exc:
            print(f"[error] {path}: {type(exc).__name__}: {exc}", file=sys.stderr)
            return
        if not members:
            print(f"[info] {path}: no .fb2 in the archive", file=sys.stderr)
        for member_name, data in members:
            yield path, member_name, data
        return
    print(f"[error] {path}: need .fb2, .zip or a folder", file=sys.stderr)


def cmd_extract(sources: list[str], out_dir: str, quiet: bool) -> int:
    """Pull all images out of books into a folder. Returns the exit code."""
    if not sources:
        print("[error] --extract: give a file or a folder", file=sys.stderr)
        return 2
    if not out_dir:
        print("[error] --extract: empty --dir", file=sys.stderr)
        return 2
    try:
        os.makedirs(out_dir, exist_ok=True)
    except OSError as exc:
        print(f"[error] folder {out_dir} not created: {exc}", file=sys.stderr)
        return 1
    count = 0
    for src_path, book_name, payload in _iter_fb2_payloads(sources):
        try:
            text, _ = decode_fb2_payload(payload)
        except Fb2OptError as exc:
            print(f"[error] {src_path}: {exc}", file=sys.stderr)
            continue
        for match in BINARY_RE.finditer(text):
            attrs, body = match.group(1), match.group(2)
            id_match = ID_RE.search(attrs or "")
            raw = decode_body(body)
            if raw is None:
                continue
            kind = detect_kind(raw, attrs or "")
            ext = {"png": "png", "jpg": "jpg", "gif": "gif"}.get(kind, "bin")
            base = sanitize_filename(id_match.group(1)) if id_match else f"img_{count}"
            stem, cur_ext = os.path.splitext(base)
            fname = base if cur_ext.lower() == f".{ext}" else f"{stem or base}.{ext}"
            dest = unique_path(os.path.join(out_dir, fname))
            try:
                with open(dest, "wb") as fh:
                    fh.write(raw)
            except OSError as exc:
                print(f"[error] {dest}: not written: {exc}", file=sys.stderr)
                continue
            count += 1
            if not quiet:
                print(f"  -> {os.path.basename(dest)} (from {book_name})")
    if not quiet:
        print(f"[done] images pulled: {count} → {out_dir}")
    return 0


# --------------------------------------------------------------------------
# --pack mode
# --------------------------------------------------------------------------

def _find_replacement(img_id: str, img_dir: str) -> str | None:
    """Find the image file for an id among neighbors. None — not found."""
    if not img_id or not img_dir or not os.path.isdir(img_dir):
        return None
    stem, _ = os.path.splitext(img_id)
    candidates = [img_id,
                  f"{img_id}.png", f"{img_id}.jpg", f"{img_id}.jpeg", f"{img_id}.gif",
                  f"{stem}.png", f"{stem}.jpg", f"{stem}.jpeg", f"{stem}.gif"]
    seen: set[str] = set()
    for name in candidates:
        if not name or name in seen:
            continue
        seen.add(name)
        full = os.path.join(img_dir, name)
        if os.path.isfile(full):
            return full
    return None


def cmd_pack(fb2_files: list[str], img_dir: str, quiet: bool) -> int:
    """Put images from a folder into a book. Input untouched, writes packed_*."""
    if not fb2_files:
        print("[error] --pack: give a .fb2 book", file=sys.stderr)
        return 2
    if not img_dir or not os.path.isdir(img_dir):
        print(f"[error] --pack: no image folder: {img_dir}",
              file=sys.stderr)
        return 2
    failures = 0
    for path in fb2_files:
        if isinstance(path, str) and path.lower().endswith(".zip"):
            print(f"[error] --pack needs an unpacked .fb2, not an archive: {path}",
                  file=sys.stderr)
            failures += 1
            continue
        if not os.path.isfile(path):
            print(f"[error] {path}: file not found", file=sys.stderr)
            failures += 1
            continue
        try:
            with open(path, "rb") as fh:
                payload = fh.read()
        except OSError as exc:
            print(f"[error] {path}: cannot read: {exc}", file=sys.stderr)
            failures += 1
            continue
        try:
            text, encoding = decode_fb2_payload(payload)
        except Fb2OptError as exc:
            print(f"[error] {path}: {exc}", file=sys.stderr)
            failures += 1
            continue
        updated = 0

        def _replace(match: re.Match) -> str:
            nonlocal updated
            attrs, _body = match.group(1), match.group(2)
            id_match = ID_RE.search(attrs or "")
            if not id_match:
                return match.group(0)
            found = _find_replacement(id_match.group(1), img_dir)
            if found is None:
                return match.group(0)
            try:
                with open(found, "rb") as fh:
                    data = fh.read()
            except OSError:
                return match.group(0)
            if not data:
                return match.group(0)
            updated += 1
            if not quiet:
                print(f"  [updated] {os.path.basename(found)} "
                      f"-> id='{id_match.group(1)}'")
            return f"<binary{attrs}>{encode_body(data)}</binary>"

        new_text = BINARY_RE.sub(_replace, text)
        if updated == 0:
            if not quiet:
                print(f"[info] {path}: no images to swap in {img_dir}")
            continue
        directory, base = os.path.split(os.path.abspath(path))
        dest = unique_path(os.path.join(directory, f"packed_{base}"))
        try:
            with open(dest, "wb") as fh:
                fh.write(new_text.encode(encoding))
        except OSError as exc:
            print(f"[error] {dest}: not written: {exc}", file=sys.stderr)
            failures += 1
            continue
        if not quiet:
            print(f"[done] {path}: images updated: {updated} → {dest}")
    return 1 if failures else 0


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------

def parse_args(argv: list[str] | None) -> argparse.Namespace:
    """Parse command line arguments."""
    parser = argparse.ArgumentParser(
        prog="fb2opt",
        description="Lossless optimization of FB2 books (.fb2.zip). "
                    "The original is replaced only if the new file is smaller.",
        epilog=format_deps(),
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("files", nargs="*", help="books .fb2.zip / .fb2 (--extract: sources; with -r: folders to walk)")
    parser.add_argument("--extract", action="store_true",
                        help="pull images out of books")
    parser.add_argument("--pack", action="store_true",
                        help="put images from a folder into a book")
    parser.add_argument("--dir", default="",
                        help="for --extract: where to pull to (default: cwd); "
                             "for --pack: where to take images from (default: cwd)")
    parser.add_argument("--deps", action="store_true",
                        help="show dependencies and exit")
    parser.add_argument("-q", "--quiet", action="store_true",
                        help="print errors only")
    parser.add_argument("-r", "--recursive", action="store_true",
                        help="walk folders and optimize every .fb2.zip inside")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    parser.add_argument("--keep-tmp", action="store_true",
                        help="keep temp files (debugging)")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    """Entry point. Returns the exit code."""
    args = parse_args(argv)
    if args.deps:
        print(format_deps())
        return 0
    if args.extract and args.pack:
        print("[error] --extract and --pack do not mix", file=sys.stderr)
        return 2
    if args.extract:
        return cmd_extract(args.files, args.dir or os.getcwd(), args.quiet)
    if args.pack:
        return cmd_pack(args.files, args.dir or os.getcwd(), args.quiet)
    # Default mode — optimize. No files: short hint + dependencies.
    if not args.files:
        print(short_hint())
        return 2
    return _run_optimize_batch(args.files, args.quiet, args.keep_tmp,
                                 args.recursive)


def _expand_sources(files: list[str], recursive: bool) -> list[str]:
    """Expand folders into book files when -r is given, else pass through."""
    if not files:
        return []
    expanded: list[str] = []
    for item in files:
        if recursive and isinstance(item, str) and os.path.isdir(item):
            for root, _, names in os.walk(item):
                for fn in sorted(names):
                    # Packed books only: foreign zips stay out (no
                    # "no .fb2 in the archive" noise), raw .fb2 files are
                    # left alone (packing them would double the library).
                    if fn.lower().endswith(".fb2.zip"):
                        expanded.append(os.path.join(root, fn))
            continue
        expanded.append(item)
    return expanded


def _run_optimize_batch(files: list[str], quiet: bool, keep_tmp: bool,
                        recursive: bool) -> int:
    """Optimize a file list without falling on the first broken one."""
    have_ect = shutil.which("ect") is not None
    if not quiet and not have_ect:
        print("[warning] ect not found — only XML and ZIP will shrink",
              file=sys.stderr)
    expanded = _expand_sources(files, recursive)
    failures = 0
    total_saved = 0
    registry: list[str] = []
    # Census: fb2opt only ever replaces files in place, never deletes them.
    # If an input is gone when the batch is done, say so loudly.
    before = {path: os.path.lexists(path) for path in expanded
              if isinstance(path, str) and path}

    def _one(path: str, tmp_root: str) -> None:
        nonlocal failures, total_saved
        try:
            saved, line = _optimize_one(path, tmp_root, have_ect, registry)
        except Fb2OptError as exc:
            print(f"[error] {path}: {exc}", file=sys.stderr)
            failures += 1
            return
        except Exception as exc:
            # One bad file (encrypted/odd ZIP, bad disk) must not kill the batch.
            print(f"[error] {path}: unexpected {type(exc).__name__}: {exc}",
                  file=sys.stderr)
            failures += 1
            return
        total_saved += saved
        if not quiet:
            print(line)

    try:
        if keep_tmp:
            tmp_root = tempfile.mkdtemp(prefix="fb2opt-")
            if not quiet:
                print(f"[debug] temp files: {tmp_root}")
            for path in expanded:
                _one(path, tmp_root)
        else:
            with tempfile.TemporaryDirectory(prefix="fb2opt-") as tmp_root:
                for path in expanded:
                    _one(path, tmp_root)
    except KeyboardInterrupt:
        _sweep_temps(registry)
        print("[interrupted]", file=sys.stderr)
        return 130
    _sweep_temps(registry)
    for gone in _find_vanished(before):
        print(f"[error] {gone}: file disappeared during the run "
              f"(fb2opt never deletes books — restore it from backup "
              f"and check other processes)", file=sys.stderr)
        failures += 1
    if not quiet and len(expanded) > 1:
        file_word = "file" if len(expanded) == 1 else "files"
        byte_word = "byte" if total_saved == 1 else "bytes"
        print(f"Total: {len(expanded)} {file_word}, saved {total_saved} {byte_word}")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
