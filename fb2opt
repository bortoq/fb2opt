# CLI
# --------------------------------------------------------------------------

def parse_args(argv: list[str] | None) -> argparse.Namespace:
    """Parse command line arguments."""
    parser = argparse.ArgumentParser(
        prog="fb2opt",
        description="Optimization of FB2 books (.fb2.zip). "
                    "The original is replaced only if the new file is smaller.",
        epilog=f"fb2opt {VERSION}\n" + format_deps(),
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("files", nargs="*", help="books .fb2.zip / .fb2 (--extract: sources; with -r: folders to walk)")
    parser.add_argument("--extract", action="store_true",
                        help="pull images into current folder")
    parser.add_argument("--pack", action="store_true",
                        help="put images from current folder into the book")
    parser.add_argument("-q", "--quiet", action="store_true",
                        help="print errors only")
    parser.add_argument("-r", "--recursive", action="store_true",
                        help="walk folders and optimize every .fb2.zip inside "
                             "(current folder if omitted)")
    parser.add_argument("--lossy", action="store_true",
                        help="recompress PNG/JPEG with losses (needs Pillow+ffmpeg); "
                             "a lossy image is kept only if smaller")
    parser.add_argument("--lossy-ssim", default=LOSSY_DEFAULT_SSIM, type=float,
                        metavar="SSIM",
                        help="with --lossy: keep SSIM >= value "
                             f"(default {LOSSY_DEFAULT_SSIM})")
    parser.add_argument("--keep-tmp", action="store_true",
                        help="keep temp files (debugging)")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    """Entry point. Returns the exit code."""
    args = parse_args(argv)
    if args.extract and args.pack:
        print("[error] --extract and --pack do not mix", file=sys.stderr)
        return 2
    if args.extract:
        return cmd_extract(args.files, os.getcwd(), args.quiet)
    if args.pack:
        return cmd_pack(args.files, os.getcwd(), args.quiet)
    if not 0.0 < args.lossy_ssim <= 1.0:
        print(f"[error] --lossy-ssim must be within (0, 1], "
              f"got {args.lossy_ssim}", file=sys.stderr)
        return 2
    lossy = args.lossy_ssim if args.lossy else None
    # Bare -r walks the current folder (nested folders included).
    if args.recursive and not args.files and not (args.extract or args.pack):
        args.files = [os.getcwd()]
    # Default mode — optimize. No files: short hint + dependencies.
    if not args.files:
        print(short_hint())
        return 2
    return _run_optimize_batch(args.files, args.quiet, args.keep_tmp,
                                 args.recursive, lossy)


def _expand_sources(files: list[str], recursive: bool) -> list[str]:
    """Expand folders into book files when -r is given, else pass through."""
    if not files:
        return []
    expanded: list[str] = []
    for item in files:
        if recursive and isinstance(item, str) and os.path.isdir(item):
            for root, _, names in os.walk(item, followlinks=False):
                for fn in sorted(names):
                    # Packed books only: foreign zips stay out (no
                    # "no .fb2 in the archive" noise), raw .fb2 files are
                    # left alone (packing them would double the library).
                    if fn.lower().endswith(".fb2.zip"):
                        expanded.append(os.path.join(root, fn))
            continue
        expanded.append(item)
    return expanded


def _run_optimize_batch(files: list[str], quiet: bool, keep_tmp: bool,
                        recursive: bool, lossy: float | None = None
                        ) -> int:
    """Optimize a file list without falling on the first broken one."""
    have_ect = shutil.which("ect") is not None
    if not quiet and not have_ect:
        print("[warning] ect not found — only XML and ZIP will shrink",
              file=sys.stderr, flush=True)
    if lossy is not None and not _lossy_tools_ok():
        missing = [m for m, ok in (("Pillow", have_pil()),
                                   ("ffmpeg", have_ffmpeg())) if not ok]
        print(f"[error] --lossy needs {' and '.join(missing)} "
              f"(pip install pillow; apt install ffmpeg)", file=sys.stderr)
        return 2
    expanded = _expand_sources(files, recursive)
    registry: list[str] = []
    # Census: fb2opt only ever replaces files in place, never deletes them.
    # If an input is gone when the batch is done, say so loudly.
    before = {path: os.path.lexists(path) for path in expanded
              if isinstance(path, str) and path}
    # All cores, no flag: files across threads, images inside a file
    # across threads too (images win when the batch is a single book).
    cpus = _cpu_count()
    file_workers = max(1, min(cpus, len(expanded)))
    img_workers = max(1, cpus // max(1, len(expanded)))

    def _one(path: str, tmp_root: str) -> tuple[int, str | None,
                                               str | None, bool]:
        """Optimize one file. Returns (saved, stdout, stderr, failed)."""
        try:
            saved, line = _optimize_one(path, tmp_root, have_ect, registry,
                                        lossy, img_workers)
        except Fb2OptError as exc:
            return 0, None, f"[error] {path}: {exc}", True
        except Exception as exc:
            # One bad file (encrypted/odd ZIP, bad disk) must not kill batch.
            return (0, None,
                    f"[error] {path}: unexpected {type(exc).__name__}: {exc}",
                    True)
        if quiet:
            return saved, None, None, False
        return saved, line, None, False

    def _emit(saved: int, outline: str | None,
            errline: str | None, failed: bool,
            acc: list) -> None:
        """Account one finished file and print its line at once. Never raises."""
        acc[0] += failed
        acc[1] += saved
        try:
            with _PRINT_LOCK:
                if errline is not None:
                    print(errline, file=sys.stderr, flush=True)
                if outline is not None:
                    print(outline, flush=True)
        except OSError:
            pass

    def _run_stream(tmp_root: str, acc: list) -> None:
        """Run the batch, printing each file line as it finishes."""
        if file_workers <= 1 or not expanded:
            for path in expanded:
                _emit(*_one(path, tmp_root), acc)
            return
        ex = concurrent.futures.ThreadPoolExecutor(max_workers=file_workers)
        try:
            futs = [ex.submit(_one, path, tmp_root) for path in expanded]
            try:
                for fut in concurrent.futures.as_completed(futs):
                    _emit(*fut.result(), acc)
            except KeyboardInterrupt:
                for fut in futs:
                    fut.cancel()
                ex.shutdown(wait=False)
                raise
            else:
                ex.shutdown(wait=True)
        except KeyboardInterrupt:
            try:
                ex.shutdown(wait=False)
            except Exception:
                pass
            raise

    acc = [0, 0]  # [failures, total_saved]
    try:
        if keep_tmp:
            tmp_root = tempfile.mkdtemp(prefix="fb2opt-")
            if not quiet:
                with _PRINT_LOCK:
                    print(f"[debug] temp files: {tmp_root}", flush=True)
            _run_stream(tmp_root, acc)
        else:
            with tempfile.TemporaryDirectory(prefix="fb2opt-") as tmp_root:
                _run_stream(tmp_root, acc)
    except KeyboardInterrupt:
        _sweep_temps(registry)
        with _PRINT_LOCK:
            print("[interrupted]", file=sys.stderr, flush=True)
        return 130
    _sweep_temps(registry)
    failures, total_saved = acc
    for gone in _find_vanished(before):
        with _PRINT_LOCK:
            print(f"[error] {gone}: file disappeared during the run "
                  f"(fb2opt never deletes books — restore it from backup "
                  f"and check other processes)", file=sys.stderr, flush=True)
        failures += 1
    if not quiet and len(expanded) > 1:
        file_word = "file" if len(expanded) == 1 else "files"
        byte_word = "byte" if total_saved == 1 else "bytes"
        with _PRINT_LOCK:
            print(f"Total: {len(expanded)} {file_word}, saved {total_saved} {byte_word}",
                  flush=True)
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
