# --------------------------------------------------------------------------
# Constants
# --------------------------------------------------------------------------

BINARY_RE = re.compile(r"<binary\b([^>]*)>(.*?)</binary\s*>",
                       re.DOTALL | re.IGNORECASE)
ID_RE = re.compile(r"""id\s*=\s*["']([^"']+)["']""", re.IGNORECASE)
COMMENT_RE = re.compile(r"<!--.*?-->", re.DOTALL)
CDATA_RE = re.compile(r"<!\[CDATA\[.*?\]\]>", re.DOTALL)
# Whitespace strictly between two tags (element-only content). Never touches text.
# Lookahead keeps the right tag unconsumed: one pass handles chained gaps O(N).
GAP_RE = re.compile(r"(<[^<>]*>)[ \t\r\n]+(?=(<[^<>]*>))")
# Gaps between two of these render as a space: collapse to one space,
# everywhere else the gap is removed entirely.
INLINE_TAGS = frozenset({"a", "code", "emphasis", "image", "strikethrough",
                         "strong", "style", "sub", "sup"})

DEPS: tuple[tuple[str, str], ...] = (
    ("ect", "lossless PNG / JPEG / ZIP"),
    ("oxipng", "PNG reductions before ect --reuse (optional)"),
    ("jpegtran", "JPEG entropy finish after ect (optional)"),
    ("Pillow", "lossy JPEG / PNG encoding (with --lossy only)"),
    ("ffmpeg", "lossy quality metric SSIM (with --lossy only)"),
)

PNG_MAGIC = b"\x89PNG\r\n\x1a\n"
JPEG_MAGIC = b"\xff\xd8\xff"
PNG_TRAILER = b"\x00\x00\x00\x00IEND\xaeB`\x82"
JPEG_TRAILER = b"\xff\xd9"

TOOL_TIMEOUT = 600

VERSION = "4.7"

# Smart image heuristics (real-world files of unknown origin).
LOSSY_MAX_SIDE = 1920   # downscale anything larger (reader screens end here)
LOSSY_MIN_BYTES = 2048  # skip the metric search on tiny images (not worth it)
LOSSY_PNG_MAX_PX = 2000000  # JPEG->PNG crossover bound (keeps ect -9 fast)
GRAY_PROBE_SCORE = 6.0  # below this mean chroma: one extra L-mode probe
ECT_FAST_BYTES = 300000  # below this an ect pass is instant: always try
CLOSE_RATIO = 1.2  # ect only gets its chance within 20% of packed base

LOSSY_DEFAULT_SSIM = 0.92

GENERIC_SAFE_FORMATS = frozenset({"BMP", "PPM"})

# DoS guards: hostile archives/images must fail loudly, not OOM the batch.
MAX_ARCHIVE_MEMBERS = 10000  # entries per ZIP
MAX_MEMBER_BYTES = 500 * 1024 * 1024  # one unpacked member
MAX_ARCHIVE_BYTES = 1024 * 1024 * 1024  # unpacked total per archive
MAX_IMAGE_PX = 50_000_000  # decoded pixels per image (~50 MP)

_UMASK_LOCK = threading.Lock()
_CACHED_UMASK: int | None = None
_REGISTRY_LOCK = threading.Lock()
_PRINT_LOCK = threading.Lock()


class Fb2OptError(Exception):
    """Expected per-file error (printed, does not stop the batch)."""


# --------------------------------------------------------------------------
# Stats
# --------------------------------------------------------------------------

@dataclass
class Fb2Stats:
    pics: int = 0
    png_saved: int = 0
    jpg_saved: int = 0
    other_saved: int = 0
    xml_saved: int = 0
    skipped: int = 0  # binary blocks left alone (no id / broken base64)
    marked: int = 0  # images already lossy-stamped, left untouched
    marks: int = 0  # annotation bytes saved (+) or spent (-) on lossy marks
    reopened: int = 0  # stamped images re-opened at a stricter target

    def add(self, other: "Fb2Stats") -> None:
        self.marked += other.marked
        self.marks += other.marks
        self.reopened += other.reopened
        self.pics += other.pics
        self.png_saved += other.png_saved
        self.jpg_saved += other.jpg_saved
        self.other_saved += other.other_saved
        self.xml_saved += other.xml_saved
        self.skipped += other.skipped

    def breakdown(self) -> str:
        # Show only types with nonzero savings; zeros carry no information.
        parts = []
        for label, value in (("xml", self.xml_saved),
                             ("png", self.png_saved),
                             ("jpg", self.jpg_saved),
                             ("other", self.other_saved),
                             ("marks", self.marks)):
            if value:
                parts.append(f"{label}: {value}")
        if not parts:
            parts.append("repack only")
        return ", ".join(parts)


@dataclass
class _Image:
    idx: int
    img_id: str
    kind: str            # png | jpg | gif | other
    raw: bytes           # original image bytes
    orig_b64_len: int    # base64 body length in the source file (as is)
    attrs: str           # attributes of the <binary ...> tag
    orig_body: str = ""   # original base64 body (for byte-exact keep)


# --------------------------------------------------------------------------
# Small pure helpers (guard clauses first)
# --------------------------------------------------------------------------

def sanitize_filename(name: object) -> str:
    """Turn an image id into a safe file name."""
    if not isinstance(name, str) or not name:
        return "img"
    safe = re.sub(r'[\\/*?:"\n<>|]', "_", name).strip()
    return safe or "img"


def run_tool(cmd: list[str]) -> bool:
    """Run an external optimizer. Never raises."""
    if not cmd:
        return False
    try:
        done = subprocess.run(cmd, stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=TOOL_TIMEOUT)
    except (OSError, subprocess.SubprocessError):
        return False
    return done.returncode == 0


def detect_kind(raw: bytes, attrs: str) -> str:
    """Detect the image type: magic bytes first, then the tag hint."""
    if not raw:
        return "other"
    if raw.startswith(PNG_MAGIC):
        return "png"
    if raw.startswith(JPEG_MAGIC):
        return "jpg"
    if raw.startswith((b"GIF87a", b"GIF89a")):
        return "gif"
    hint = (attrs or "").lower()
    if "png" in hint:
        return "png"
    if "jpg" in hint or "jpeg" in hint:
        return "jpg"
    if "gif" in hint:
        return "gif"
    return "other"


def decode_body(body: str) -> bytes | None:
    """Decode a <binary> base64 body. None — broken block, keep it as is."""
    if body is None:
        return None
    try:
        cleaned = "".join(body.split())
    except (AttributeError, TypeError):
        return None
    if not cleaned:
        return None
    try:
        data = base64.b64decode(cleaned, validate=True)
    except (binascii.Error, ValueError):
        return None
    return data or None


def encode_body(raw: bytes) -> str:
    """Encode image bytes as single-line base64 (no wrapping at all)."""
    return base64.b64encode(raw).decode("ascii")


def _flat_b64_len(raw: bytes) -> int:
    """Single-line base64 length without encoding: 4 * ceil(n/3)."""
    if not raw:
        return 0
    try:
        return (len(raw) + 2) // 3 * 4
    except (TypeError, OverflowError):
        return 0


def _packed_cost(raw: bytes) -> int:
    """Packed size proxy: the exact base64 body under zlib-9 (sub-ms)."""
    if not raw:
        return 0
    try:
        return len(zlib.compress(encode_body(raw).encode("ascii"), 9))
    except (TypeError, ValueError, zlib.error):
        return len(raw) if isinstance(raw, bytes) else 0


def _tag_name(tag: str) -> str:
    """Tag name of `<...>` without brackets, slash or attributes ("" if none)."""
    if not tag:
        return ""
    match = re.match(r"</?\s*([A-Za-z][\w:.-]*)", tag)
    if not match:
        return ""
    return match.group(1).split(":")[-1].lower()  # fb:emphasis counts as emphasis


def _gap_replace(match: re.Match) -> str:
    """Collapse one inter-tag gap: one space between two inline tags, else nothing.

    GAP_RE uses a lookahead for the right tag, so it stays in the input
    and the next gap can start from it — a single sub() pass is enough. """
    left, right = match.group(1), match.group(2)
    if _tag_name(left) in INLINE_TAGS and _tag_name(right) in INLINE_TAGS:
        return f"{left} "
    return left


def _ignored_spans(text: str) -> list[tuple[int, int]]:
    """Spans of comments and CDATA (never real <binary> blocks)."""
    if not text:
        return []
    spans: list[tuple[int, int]] = []
    try:
        for rx in (COMMENT_RE, CDATA_RE):
            for m in rx.finditer(text):
                spans.append((m.start(), m.end()))
    except (TypeError, re.error):
        return []
    return spans


def _binary_matches(text: str):
    """BINARY_RE matches outside comments/CDATA (real images only)."""
    if not text:
        return
    spans = _ignored_spans(text)

    def _inside(pos: int) -> bool:
        for s, e in spans:
            if s <= pos < e:
                return True
        return False

    for m in BINARY_RE.finditer(text):
        if not _inside(m.start()):
            yield m


def minify_skeleton(text: str) -> str:
    """Minify the XML skeleton without touching rendered text.

    Only rendering-neutral transforms:
      comments (outside CDATA) are dropped;
      whitespace strictly between two tags collapses — one space stays
      between two inline tags, everywhere else the gap is removed
      (repeated to a fixpoint, so chained gaps all collapse).
    CDATA sections ride through masked and come back byte-exact.
    """
    if not text:
        return text
    token = uuid.uuid4().hex
    cdata: list[str] = []

    def _mask(match: re.Match) -> str:
        cdata.append(match.group(0))
        return f"__FB2OPT_CDATA_{token}_{len(cdata) - 1}__"

    masked = CDATA_RE.sub(_mask, text)
    masked = COMMENT_RE.sub("", masked)
    # Single pass: GAP_RE lookahead leaves the right tag for the next gap.
    masked = GAP_RE.sub(_gap_replace, masked)
    for idx, section in enumerate(cdata):
        masked = masked.replace(f"__FB2OPT_CDATA_{token}_{idx}__", section, 1)
    return masked


def decode_fb2_payload(payload: bytes) -> tuple[str, str]:
    """Decode FB2 bytes to text. Returns (text, encoding)."""
    if payload is None:
        raise Fb2OptError("empty FB2 data")
    try:
        return payload.decode("utf-8"), "utf-8"
    except UnicodeDecodeError:
        pass
    try:
        return payload.decode("cp1251"), "cp1251"
    except UnicodeDecodeError as exc:
        raise Fb2OptError(f"unknown FB2 encoding: {exc}") from exc


def unique_path(path: str) -> str:
    """Pick a free file name (adds _2, _3, ... on collision)."""
    if not os.path.exists(path):
        return path
    stem, ext = os.path.splitext(path)
    n = 2
    while os.path.exists(f"{stem}_{n}{ext}"):
        n += 1
    return f"{stem}_{n}{ext}"


