# --------------------------------------------------------------------------
# Image optimization
# --------------------------------------------------------------------------

def _looks_complete(kind: str, data: bytes) -> bool:
    """Sanity check: same header magic and a proper end marker."""
    if not data:
        return False
    if kind == "png":
        return data.startswith(PNG_MAGIC) and data.endswith(PNG_TRAILER)
    if kind == "jpg":
        return data.startswith(JPEG_MAGIC) and data.endswith(JPEG_TRAILER)
    return True


def _process_image(img: _Image, workdir: str, have_ect: bool,
                   lossy: float | None,
                   lossy_marks: list[int] | None) -> tuple[int, bytes]:
    """Optimize one image; returns (idx, final_bytes). Thread-safe.

    Temp names carry the image idx, so workers never share a file.
    Appends to lossy_marks are atomic under the GIL; order is irrelevant
    (the list is consumed as a set).
    """
    if not img.raw:
        return img.idx, img.raw
    if img.kind not in ("png", "jpg"):
        return img.idx, img.raw  # gif/other need no tool, keep as is
    if not have_ect and lossy is None and Image is None:
        return img.idx, img.raw  # no optimizer at all: keep as is
    base = img.raw
    if have_ect:
        tmp = os.path.join(workdir, f"{img.idx:04d}_{sanitize_filename(img.img_id)}"
                                    f".{img.kind}")
        try:
            with open(tmp, "wb") as fh:
                fh.write(img.raw)
        except OSError:
            return img.idx, img.raw
        _ect_squeeze(tmp, img.kind)
        try:
            with open(tmp, "rb") as fh:
                optimized = fh.read()
        except OSError:
            optimized = img.raw
        # Guard against pessimization: keep the packed-smaller.
        if 0 < _packed_cost(optimized) < _packed_cost(img.raw):
            # The optimizer must return a complete image, not a truncated one.
            if _looks_complete(img.kind, optimized):
                base = optimized
            else:
                print(f"[warning] {img.img_id}: optimizer output failed validation, "
                      f"kept original", file=sys.stderr)
        try:
            os.unlink(tmp)
        except OSError:
            pass
    if Image is not None:
        base = _try_lossless_variants(img, workdir, base, have_ect)
    if lossy is not None and _lossy_tools_ok():
        base = _try_lossy(img, workdir, lossy, base, lossy_marks)
    return img.idx, base


def optimize_images(images: list[_Image], workdir: str,
                    have_ect: bool, lossy: float | None = None,
                    lossy_marks: list[int] | None = None,
                    workers: int = 1) -> dict[int, bytes]:
    """Run images through external optimizers.

    Returns {idx: final_bytes}. Each image keeps the smaller of
    (original, optimized) — a single file never grows.
    With lossy (min SSIM 0..1): a metric-gated lossy variant may win,
    but only when strictly smaller than the lossless result.
    workers > 1 spreads images over threads (same bytes out).
    """
    result: dict[int, bytes] = {}
    if not images:
        return result
    os.makedirs(workdir, exist_ok=True)
    if workers <= 1 or len(images) <= 1:
        for img in images:
            idx, final = _process_image(img, workdir, have_ect, lossy,
                                        lossy_marks)
            result[idx] = final
        return result
    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as ex:
        futs = [ex.submit(_process_image, img, workdir, have_ect, lossy,
                          lossy_marks) for img in images]
        for fut in futs:
            idx, final = fut.result()
            result[idx] = final
    return result


# --------------------------------------------------------------------------
# Smart image heuristics: what the file itself tells us
# --------------------------------------------------------------------------

def _pixels_equal(a: bytes, b: bytes) -> bool:
    """Same decoded size and RGB pixels. The lossless-verdict primitive."""
    ia, ib = _pil_open(a), _pil_open(b)
    if ia is None or ib is None:
        return False
    if tuple(ia.size) != tuple(ib.size):
        return False
    try:
        diff = ImageChops.difference(ia.convert("RGB"), ib.convert("RGB"))
        return diff.getbbox() is None
    except Exception:
        return False


def _has_alpha(im) -> bool:
    """Any transparency channel or palette transparency."""
    if im is None or Image is None:
        return True  # unknown: stay conservative
    try:
        if "A" in im.getbands():
            return True
        return im.info.get("transparency") is not None
    except Exception:
        return True


def _is_exact_gray(im) -> bool:
    """RGB pixels are exactly gray (R == G == B everywhere)."""
    if im is None or Image is None:
        return False
    try:
        if im.mode == "L":
            return True
        if im.mode != "RGB":
            return False
        back = im.convert("L").convert("RGB")
        return ImageChops.difference(im, back).getbbox() is None
    except Exception:
        return False


def _gray_score(im) -> float:
    """Mean per-pixel chroma energy (0 = gray). One extra L-mode probe."""
    if im is None or Image is None:
        return float("inf")
    try:
        tiny = im.convert("RGB").resize((32, 32))
        cb, cr = tiny.convert("YCbCr").split()[1:]
        flat = Image.new("L", cb.size, 128)
        return (ImageStat.Stat(ImageChops.difference(cb, flat)).mean[0]
                + ImageStat.Stat(ImageChops.difference(cr, flat)).mean[0])
    except Exception:
        return float("inf")


def _distinct_colors(im, limit: int = 257) -> int | None:
    """Distinct RGB colors up to limit; None when more (early exit)."""
    if im is None or Image is None:
        return None
    try:
        cols = im.convert("RGB").getcolors(maxcolors=limit)
    except Exception:
        return None
    return None if cols is None else len(cols)


def _scale_pair(im):
    """(work, ref): work downscaled to LOSSY_MAX_SIDE if huge, ref its RGB."""
    if im is None or Image is None:
        return None, None
    try:
        w, h = im.size
        m = max(w, h)
        work = im if m <= LOSSY_MAX_SIDE else im.resize(
            (max(1, round(w * LOSSY_MAX_SIDE / m)),
             max(1, round(h * LOSSY_MAX_SIDE / m))), Image.LANCZOS)
        if work.mode not in ("RGB", "L"):
            work = work.convert("RGB")
        return work, work.convert("RGB")
    except Exception:
        return None, None


def _set_content_type(attrs: str, kind: str) -> str:
    """Rewrite (or add) the content-type to match the new image format."""
    mime = "image/png" if kind == "png" else "image/jpeg"
    try:
        new_attrs, n = re.subn(r'content-type\s*=\s*["\'][^"\']*["\']',
                               f'content-type="{mime}"', attrs or "",
                               count=1, flags=re.IGNORECASE)
    except Exception:
        return attrs
    if n:
        return new_attrs
    return attrs + ' content-type="' + mime + '"'


LOSSY_MARK = "fb2opt-lossy"


def _lossy_mark(attrs: str) -> float | None:
    """Applied lossy target read back from a <binary> tag, if any."""
    if not attrs:
        return None
    try:
        match = re.search(LOSSY_MARK + r'\s*=\s*"([0-9.]+)"', attrs)
        return float(match.group(1)) if match else None
    except (ValueError, AttributeError):
        return None


def _strip_mark_from_attrs(attrs: str) -> str:
    """Drop a parseable legacy lossy mark from a tag's attributes."""
    if not attrs or _lossy_mark(attrs) is None:
        return attrs
    try:
        return re.sub(r"\s*" + LOSSY_MARK + r'\s*=\s*"[0-9.]+"', "", attrs,
                      count=1)
    except Exception:
        return attrs


def _set_lossy_mark(attrs: str, target: float) -> str:
    """Stamp a lossy target on a tag (fallback for books with no place
    for a token — keeps protection where validity is already broken)."""
    stamp = f'{LOSSY_MARK}="{target:.4g}"'
    if not attrs:
        return " " + stamp
    try:
        new_attrs, n = re.subn(LOSSY_MARK + r'\s*=\s*"[0-9.]+"', stamp,
                               attrs, count=1)
    except (TypeError, re.error):
        return attrs
    return new_attrs if n else f"{attrs} {stamp}"


def _parse_lossy_token(text: str) -> dict[str, float]:
    """Read back {img_id: target} from program-used token(s)."""
    out: dict[str, float] = {}
    if not text:
        return out
    try:
        spans = re.finditer(LOSSY_MARK + r"\[([^\]]*)\]", text or "")
    except Exception:
        return out
    for span in spans:
        try:
            groups = span.group(1).split(";")
        except Exception:
            continue
        for group in groups:
            target_txt, sep, ids = group.partition(":")
            if not sep:
                continue
            try:
                target = float(target_txt)
            except ValueError:
                continue
            if not 0.0 < target <= 1.0:
                continue
            for enc in ids.split(","):
                enc = enc.strip()
                if not enc:
                    continue
                try:
                    iid = unquote(enc)
                except Exception:
                    continue
                if not iid:
                    continue
                prev = out.get(iid)
                out[iid] = target if prev is None else min(prev, target)
    return out


def _render_lossy_token(marks: dict[str, float]) -> str:
    """Serialize {img_id: target} into one program-used token (stable order)."""
    if not marks:
        return ""
    parts = []
    try:
        targets = sorted(set(marks.values()))
    except Exception:
        return ""
    for target in targets:
        ids = sorted(i for i, t in marks.items() if t == target)
        try:
            enc = ",".join(quote(i, safe="") for i in ids)
            parts.append(f"{target:.4g}:{enc}")
        except Exception:
            continue
    if not parts:
        return ""
    return LOSSY_MARK + "[" + ";".join(parts) + "]"


def _token_bytes(text: str) -> int:
    """Total bytes of lossy tokens in the text (for annotation accounting)."""
    try:
        return sum(len(m.group(0)) for m in
                   re.finditer(LOSSY_MARK + r"\[[^\]]*\]", text or ""))
    except (TypeError, re.error):
        return 0


def _strip_legacy_marks(text: str) -> tuple[str, int]:
    """Drop parseable legacy marks from <binary> tags. Returns (text, bytes)."""
    removed = [0]

    def _one(match: re.Match) -> str:
        tag = match.group(0)
        if _lossy_mark(tag) is None:
            return tag
        try:
            new_tag = re.sub(r"\s*" + LOSSY_MARK + r'\s*=\s*"[0-9.]+"',
                             "", tag, count=1)
        except Exception:
            return tag
        removed[0] += len(tag) - len(new_tag)
        return new_tag

    try:
        out = re.sub(r"<binary\b[^>]*>", _one, text, flags=re.IGNORECASE)
    except Exception:
        return text, 0
    return out, removed[0]


def _project_lossy_marks(text: str, images: list[_Image],
                         lossy: float | None
                         ) -> tuple[dict[str, float], set[str]]:
    """Collect known marks (token + legacy tag attrs) and project them
    into images, so the variant skip and the shield counter work unchanged.
    Output tags are rewritten separately from real attrs plus one token.
    """
    known: dict[str, float] = {}
    present: set[str] = set()
    if lossy is None:
        return known, present
    try:
        known = _parse_lossy_token(text)
        for tag_m in re.finditer(r"<binary\b[^>]*>", text or "",
                                 re.IGNORECASE):
            tag = tag_m.group(0)
            id_m = ID_RE.search(tag)
            if not id_m:
                continue
            present.add(id_m.group(1))
            mark = _lossy_mark(tag)
            if mark is not None:
                prev = known.get(id_m.group(1))
                known[id_m.group(1)] = mark if prev is None else min(prev, mark)
        for img in images:
            if img.img_id in known and LOSSY_MARK + "=" not in (img.attrs or ""):
                img.attrs = (f'{img.attrs or ""} {LOSSY_MARK}="'
                             f'{known[img.img_id]:.4g}"')
    except Exception:
        return {}, present
    return known, present


def _write_lossy_token(skeleton: str, known: dict[str, float],
                       present_ids: set[str], images: list[_Image],
                       mark_set: set[int], lossy: float,
                       real_attrs: dict[int, str]
                       ) -> tuple[str, int, int, int]:
    """Merge wins into the token, place it, migrate legacy marks.

    Returns (skeleton, old_ann_bytes, new_ann_bytes, reopened_count).
    reopened = images already stamped that a stricter target re-opens:
    their quality is then measured against degraded pixels, not the
    original — worth one stderr line. Never raises.
    """
    reopened = sum(1 for img in images
                   if img.idx in mark_set and img.img_id in known
                   and known[img.img_id] > lossy)
    try:
        for img in images:
            if img.idx in mark_set:
                known[img.img_id] = lossy
        known = {iid: tgt for iid, tgt in known.items() if iid in present_ids}
        token = _render_lossy_token(known)
        if not token:
            old_ann = _token_bytes(skeleton)
            try:
                skeleton = re.sub(LOSSY_MARK + r"\[[^\]]*\]", "", skeleton)
            except Exception:
                pass
            return skeleton, old_ann, 0, reopened
        pre_tok = _token_bytes(skeleton)
        prog = re.search(r"(<program-used\b[^>]*>)(.*?)(</program-used\s*>)",
                         skeleton, re.DOTALL | re.IGNORECASE)
        extra = 0 if prog is None else (1 if prog.group(2).strip() else 0)
        if prog is None:
            extra = len("<program-used></program-used>")
        cand, ok = _upsert_program_used(skeleton, token)
        if ok:
            final, legacy_bytes = _strip_legacy_marks(cand)
            return final, pre_tok + legacy_bytes, len(token) + extra, reopened
        print("[warning] cannot place lossy token, "
              "stamping tags instead", file=sys.stderr)
        for img in images:
            if img.idx in mark_set:
                skeleton = _patch_binary_attrs(
                    skeleton, img.img_id,
                    _set_lossy_mark(real_attrs[img.idx], lossy))
        return skeleton, 0, 0, reopened
    except Exception:
        return skeleton, 0, 0, 0


def _upsert_program_used(text: str, token: str) -> tuple[str, bool]:
    """Place the token into <program-used> (create it if missing).

    Position respects the schema sequence (after authors, before date).
    Returns (text, ok); on failure the input comes back untouched.
    """
    if not text or not token:
        return text, False
    try:
        cleaned = re.sub(LOSSY_MARK + r"\[[^\]]*\]", "", text)
        prog = re.search(r"(<program-used\b[^>]*>)(.*?)(</program-used\s*>)",
                         cleaned, re.DOTALL | re.IGNORECASE)
        if prog:
            body = prog.group(2).rstrip()
            body = (body + " " + token) if body else token
            new = (cleaned[:prog.start()] + prog.group(1) + body
                   + prog.group(3) + cleaned[prog.end():])
        else:
            doc = re.search(r"<document-info\b[^>]*>(.*?)</document-info\s*>",
                            cleaned, re.DOTALL | re.IGNORECASE)
            if not doc:
                return text, False
            inner = doc.group(1)
            elem = "<program-used>" + token + "</program-used>"
            date = re.search(r"<date\b", inner, re.IGNORECASE)
            if date:
                new_inner = inner[:date.start()] + elem + inner[date.start():]
            else:
                new_inner = inner + elem
            new = (cleaned[:doc.start(1)] + new_inner
                   + cleaned[doc.end(1):])
    except Exception:
        return text, False
    if not _parse_lossy_token(new):
        return text, False
    return new, True


def _patch_binary_attrs(text: str, img_id: str, new_attrs: str) -> str:
    """Swap the <binary> tag of one id (format change keeps markup honest)."""
    if not text or not img_id or not new_attrs:
        return text
    try:
        pat = re.compile(r"<binary\b([^>]*\bid\s*=\s*[\"']"
                         + re.escape(img_id) + r"[\"'][^>]*)>",
                         re.IGNORECASE)
        return pat.sub(f"<binary{new_attrs}>", text, count=1)
    except Exception:
        return text


# --------------------------------------------------------------------------
# Lossy recompression (--lossy), gated by a perceptual metric
# --------------------------------------------------------------------------
# JPEG quality is non-monotonic under SSIM (re-encoding at the original's
# own quality re-quantizes almost idempotently, a nearby quality may score
# worse), so the search walks a ladder upward and takes the first candidate
# that meets the target — the smallest passing quality by construction.

LOSSY_JPEG_LADDER = (60, 65, 70, 75, 80, 85, 90, 95)
LOSSY_PNG_LADDER = (64, 128, 192)
SSIM_TIMEOUT = 120


def _jpegtran_finish(path: str) -> None:
    """Extra lossless entropy pass (mozjpeg/jpegtran). Never raises.

    Runs after ect on a temp copy and moves it back only when valid:
    the original is never lost through this path. """
    if not path or not os.path.isfile(path):
        return
    try:
        handle, tmp = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(path)),
                                        prefix=".fb2opt-jt-", suffix=".jpg")
        os.close(handle)
    except OSError:
        return
    try:
        ok = run_tool(["jpegtran", "-optimize", "-progressive",
                       "-copy", "none", "-outfile", tmp, path])
        if not ok:
            return
        try:
            with open(tmp, "rb") as fh:
                out = fh.read()
        except OSError:
            return
        if _looks_complete("jpg", out):
            try:
                os.replace(tmp, path)
            except OSError:
                pass
    finally:
        try:
            if os.path.exists(tmp):
                os.unlink(tmp)
        except OSError:
            pass


def _ect_squeeze(path: str, kind: str) -> None:
    """Lossless external passes for the image kind. Never raises.

    PNG: oxipng reductions first (keeps all chunks by default, so text
    and ICC survive), then ect recompresses the IDAT (--reuse keeps the
    filters oxipng chose). JPEG: ect, then a jpegtran entropy finish.
    Every stage is optional: missing tools are simply skipped. """
    if kind == "png":
        if have_oxipng():
            run_tool(["oxipng", "-o", "4", path])
        if _ect_reuse_ok():
            run_tool(["ect", "-9", "--reuse", path])
        else:
            run_tool(["ect", "-9", path])
    else:
        run_tool(["ect", "-9", "-strip", "-progressive", path])
        if have_jpegtran():
            _jpegtran_finish(path)


def _encode_png_bytes(im, meta_from=None) -> bytes | None:
    """PIL PNG bytes, metadata-preserving. None on encode trouble."""
    if im is None:
        return None
    if meta_from is None:
        meta_from = im
    try:
        buf = io.BytesIO()
        _save_png(im, buf, meta_from=meta_from)
        return buf.getvalue()
    except (OSError, ValueError):
        return None


def _exact_png_candidates(img: _Image, im) -> list[tuple[bytes, str]]:
    """Pixel-exact PNG re-encodings: gray, rgb->palette, palette trim."""
    cands: list[tuple[bytes, str]] = []
    if im.mode == "RGB" and _is_exact_gray(im):
        gray = im.convert("L")
        enc = _encode_png_bytes(gray, im)
        if enc is not None and _pixels_equal(enc, img.raw):
            cands.append((enc, "png"))
    if im.mode == "RGB":
        n = _distinct_colors(im)
        if n is not None and 1 <= n <= 256:
            q = im.quantize(colors=max(n, 2), method=Image.MEDIANCUT,
                            dither=Image.Dither.NONE)
            enc = _encode_png_bytes(q, im)
            if enc is not None and _pixels_equal(enc, img.raw):
                cands.append((enc, "png"))
    if im.mode == "P":
        try:
            pal_size = len(im.getpalette()) // 3
        except (TypeError, AttributeError):
            pal_size = 256
        n = _distinct_colors(im)
        if n is not None and 1 <= n < pal_size:
            q = im.convert("RGB").quantize(
                colors=max(n, 2), method=Image.MEDIANCUT,
                dither=Image.Dither.NONE)
            enc = _encode_png_bytes(q, im)
            if enc is not None and _pixels_equal(enc, img.raw):
                cands.append((enc, "png"))
    return cands


def _exact_crossover_candidates(img: _Image, im
                                ) -> list[tuple[bytes, str]]:
    """Pixel-exact re-encoding into PNG for JPEG and simple formats.

    Flat graphics stored as JPEG (or BMP/PPM from sloppy converters)
    often win as PNG. Skipped with EXIF/ICC aboard: PNG cannot carry
    them, and EXIF orientation decides how readers show the file —
    never flip silently. GIF stays out (animation lives frame by frame).
    """
    if img.kind == "jpg":
        pass
    elif (img.kind not in ("png", "jpg", "gif")
          and (im.format or "").upper() in GENERIC_SAFE_FORMATS):
        pass
    else:
        return []
    if im.mode not in ("RGB", "L", "P"):
        return []
    if im.info.get("exif") or im.info.get("icc_profile"):
        return []
    w, h = im.size
    if w * h > LOSSY_PNG_MAX_PX:
        return []
    # JPEG ringing around flat graphics pushes the count into the
    # hundreds; photos have orders of magnitude more.
    n = _distinct_colors(im, limit=4097)
    if n is None or not 1 <= n <= 4096:
        return []
    enc = _encode_png_bytes(im.convert("RGB"), im)
    if enc is not None and _pixels_equal(enc, img.raw):
        return [(enc, "png")]
    return []


def _squeeze_candidate(img: _Image, workdir: str, cb: bytes, ck: str,
                       base: bytes, base_cost: int, have_ect: bool
                       ) -> tuple[bytes, int]:
    """Run one candidate through ect, keep the packed-smaller. Never raises."""
    if not have_ect:
        return cb, _packed_cost(cb)
    tmp = os.path.join(workdir, f"exact_{img.idx:04d}.{ck}")
    try:
        with open(tmp, "wb") as fh:
            fh.write(cb)
    except OSError:
        return base, base_cost
    try:
        _ect_squeeze(tmp, ck)
        try:
            with open(tmp, "rb") as fh:
                eco = fh.read()
        except OSError:
            return base, base_cost
        if (_packed_cost(eco) < base_cost
                and _looks_complete(ck, eco)
                and _pixels_equal(eco, img.raw)):
            return eco, _packed_cost(eco)
        return base, base_cost
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def _try_lossless_variants(img: _Image, workdir: str, base: bytes,
                           have_ect: bool) -> bytes:
    """Pixel-exact re-encodings: gray, palette trim, JPEG->PNG.

    Every candidate is verified identical to the source pixels and kept
    only when packed-smaller (after its own ect pass). Never raises.
    """
    if not base or Image is None or not img.raw:
        return base
    im = _pil_open(img.raw)
    if im is None or _has_alpha(im):
        return base
    try:
        # Pillow raises an open-ended zoo (struct.error, SyntaxError, ...)
        # on hostile inputs — the one place a broad net is justified.
        if img.kind == "png":
            cands = _exact_png_candidates(img, im)
        elif img.kind == "jpg":
            cands = _exact_crossover_candidates(img, im)
        elif (im.format or "").upper() in GENERIC_SAFE_FORMATS:
            cands = _exact_crossover_candidates(img, im)
        else:
            cands = []  # gif and the truly exotic: keep as is
    except Exception:
        return base
    base_cost = _packed_cost(base)
    for cb, ck in cands:
        # PIL zlib is weak on PNG: a close candidate may still win after ect.
        # Beyond CLOSE_RATIO no ect pass ever flipped the verdict — skip it.
        if not cb or (_packed_cost(cb) >= base_cost and not (
                ck == "png" and have_ect and len(cb) < ECT_FAST_BYTES
                and _packed_cost(cb) < base_cost * CLOSE_RATIO)):
            continue
        base, base_cost = _squeeze_candidate(img, workdir, cb, ck,
                                             base, base_cost, have_ect)
    return base


def _pil_open(raw: bytes):
    """Decode image bytes with Pillow. None — not decodable/too big."""
    if Image is None or not raw:
        return None
    if len(raw) > MAX_MEMBER_BYTES:
        return None
    try:
        im = Image.open(io.BytesIO(raw))
        w, h = im.size
        if w <= 0 or h <= 0 or w * h > MAX_IMAGE_PX:
            return None
        im.load()
        w2, h2 = im.size
        if w2 * h2 > MAX_IMAGE_PX:
            return None
        return im
    except Exception:
        return None


def _same_dims(raw: bytes, size: tuple[int, int]) -> bool:
    """Decodable and dimensions unchanged."""
    im = _pil_open(raw)
    return im is not None and tuple(im.size) == tuple(size)


def _ssim_score(ref_png: str, cand_png: str) -> float | None:
    """SSIM All (0..1) between two PNGs via ffmpeg. None — metric unavailable."""
    if not ref_png or not cand_png:
        return None
    try:
        done = subprocess.run(
            ["ffmpeg", "-v", "info", "-i", ref_png, "-i", cand_png,
             "-lavfi", "ssim", "-f", "null", "-"],
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
            timeout=SSIM_TIMEOUT)
    except (OSError, subprocess.SubprocessError):
        return None
    if done.returncode != 0:
        return None
    try:
        err = done.stderr.decode("utf-8", "replace")
    except Exception:
        return None
    for line in err.splitlines():
        if "SSIM " in line and "All:" in line:
            try:
                return float(line.split("All:")[1].split()[0])
            except (ValueError, IndexError):
                return None
    return None


def _save_png(im, path, meta_from=None) -> None:
    """Save PNG keeping text chunks and ICC profile when present.

    No-op on None image (edge guard, never raises).

    Metadata is taken from meta_from (the source image) when given,
    else from im itself. Falls back to a plain save on any trouble.
    """
    if im is None:
        return
    src_im = meta_from if meta_from is not None else im
    kw: dict = {"optimize": True}
    if Image is not None and src_im is not None:
        try:
            profile = src_im.info.get("icc_profile")
            if profile:
                kw["icc_profile"] = profile
            text = getattr(src_im, "text", None)
            if text and PngImagePlugin is not None:
                info = PngImagePlugin.PngInfo()
                for key, value in text.items():
                    try:
                        info.add_text(str(key), str(value))
                    except Exception:
                        continue
                kw["pnginfo"] = info
        except Exception:
            pass
    try:
        im.save(path, "PNG", **kw)
    except Exception:
        im.save(path, "PNG", optimize=True)


def _drop_paths(paths: list[str]) -> None:
    """Best-effort removal of our own temp files. Never raises."""
    for path in paths:
        try:
            os.unlink(path)
        except OSError:
            pass


def _jpeg_ladder(work, ref, stem: str, target: float,
                 gray_probe: bool = False) -> tuple[bytes, int] | None:
    """Cheapest JPEG quality with SSIM >= target. (bytes, quality) or None."""
    if Image is None or work is None or ref is None:
        return None
    # 'keep' preserves the source chroma subsampling, but only a JPEG
    # source has one; anything else (PNG, resized) uses the default.
    keep_sampling = getattr(work, "format", None) == "JPEG"
    tmps: list[str] = []
    try:
        ref_path = stem + "_ref.png"
        ref.save(ref_path)
        tmps.append(ref_path)
        for q in LOSSY_JPEG_LADDER:
            cand_jpg = stem + "_c.jpg"
            if keep_sampling:
                work.save(cand_jpg, "JPEG", quality=q, progressive=True,
                          optimize=True, subsampling="keep")
            else:
                work.save(cand_jpg, "JPEG", quality=q, progressive=True,
                          optimize=True)
            tmps.append(cand_jpg)
            try:
                with open(cand_jpg, "rb") as fh:
                    jb = fh.read()
            except OSError:
                continue
            dec = _pil_open(jb)
            if dec is None or tuple(dec.size) != tuple(ref.size):
                continue
            cand_png = stem + "_c.png"
            dec.convert("RGB").save(cand_png)
            tmps.append(cand_png)
            score = _ssim_score(ref_path, cand_png)
            if score is not None and score >= target:
                if gray_probe and work.mode == "RGB":
                    probe = _gray_probe_at(work, ref_path, ref.size, stem,
                                           q, target, tmps)
                    if probe is not None and len(probe) < len(jb):
                        return probe, q
                return jb, q
        return None
    except (OSError, ValueError):
        return None
    finally:
        _drop_paths(tmps)


def _gray_probe_at(work, ref_path: str, ref_size, stem: str, q: int,
                   target: float, tmps: list) -> bytes | None:
    """One L-mode encode at the winning quality (near-gray images only)."""
    try:
        probe_jpg = stem + "_g.jpg"
        if getattr(work, "format", None) == "JPEG":
            work.convert("L").save(probe_jpg, "JPEG", quality=q,
                                   progressive=True, optimize=True,
                                   subsampling="keep")
        else:
            work.convert("L").save(probe_jpg, "JPEG", quality=q,
                                   progressive=True, optimize=True)
        tmps.append(probe_jpg)
        with open(probe_jpg, "rb") as fh:
            lb = fh.read()
        dec = _pil_open(lb)
        if dec is None or tuple(dec.size) != tuple(ref_size):
            return None
        probe_png = stem + "_g.png"
        dec.convert("RGB").save(probe_png)
        tmps.append(probe_png)
        score = _ssim_score(ref_path, probe_png)
        if score is not None and score >= target:
            return lb
        return None
    except (OSError, ValueError):
        return None


def _lossy_jpeg(im, img: _Image, workdir: str, target: float,
                allow_cross: bool = True, base_cost: int | None = None
                ) -> tuple[bytes, tuple[int, int]] | None:
    """JPEG ladder (+L handling); PNG crossover when native doesn't win."""
    if im is None or Image is None:
        return None
    if im.mode not in ("RGB", "L", "P"):
        return None  # CMYK / alpha / exotic: keep lossless
    work, ref = _scale_pair(im)
    if work is None or ref is None:
        return None
    stem = os.path.join(workdir, f"lossy_{img.idx:04d}")
    if _is_exact_gray(work):
        w2 = work if work.mode == "L" else work.convert("L")
        hit = _jpeg_ladder(w2, ref, stem, target, False)
    else:
        if work.mode not in ("RGB", "L"):
            work = work.convert("RGB")
        hit = _jpeg_ladder(work, ref, stem, target,
                           work.mode == "RGB"
                           and _gray_score(work) < GRAY_PROBE_SCORE)
    best = None
    if hit is not None:
        best = (hit[0], tuple(ref.size))
    if allow_cross and (best is None or (base_cost is not None
                                         and _packed_cost(best[0]) >= base_cost)):
        cross = _lossy_png(work, img, workdir, target, False, base_cost)
        if cross is not None and (best is None
                                  or len(cross[0]) < len(best[0])):
            best = cross
    return best


def _lossy_png(im, img: _Image, workdir: str, target: float,
               allow_cross: bool = True, base_cost: int | None = None
               ) -> tuple[bytes, tuple[int, int]] | None:
    """Palette ladder first; JPEG crossover when native doesn't win."""
    if im is None or Image is None:
        return None
    if _has_alpha(im):
        return None  # transparency must survive byte-exact: keep lossless
    if im.mode not in ("RGB", "L", "P"):
        return None
    work, ref = _scale_pair(im)
    if work is None or ref is None:
        return None
    if work.mode == "P":
        try:
            pal_size = len(work.getpalette()) // 3
        except (TypeError, AttributeError):
            pal_size = 256
    else:
        pal_size = 1 << 24
    stem = os.path.join(workdir, f"lossy_{img.idx:04d}")
    tmps: list[str] = []
    best = None
    try:
        ref_path = stem + "_ref.png"
        ref.save(ref_path)
        tmps.append(ref_path)
        for n in LOSSY_PNG_LADDER:
            if pal_size <= n:
                continue  # nothing to quantize away
            cand_png = stem + "_c.png"
            quantized = work.convert("RGB").quantize(
                colors=n, method=Image.MEDIANCUT, dither=Image.Dither.NONE)
            _save_png(quantized, cand_png, meta_from=im)
            tmps.append(cand_png)
            try:
                with open(cand_png, "rb") as fh:
                    pb = fh.read()
            except OSError:
                continue
            dec = _pil_open(pb)
            if dec is None or tuple(dec.size) != tuple(ref.size):
                continue
            score = _ssim_score(ref_path, cand_png)
            if score is not None and score >= target:
                best = (pb, tuple(ref.size))
                break
    except (OSError, ValueError):
        best = None
    finally:
        _drop_paths(tmps)
    if allow_cross and (best is None or (base_cost is not None
                                         and _packed_cost(best[0]) >= base_cost)):
        cross = _lossy_jpeg(work, img, workdir, target, False, base_cost)
        if cross is not None and (best is None
                                  or len(cross[0]) < len(best[0])):
            best = cross
    return best


def _lossy_variant(img: _Image, workdir: str, target: float,
                   base_cost: int | None = None
                   ) -> tuple[bytes, tuple[int, int]] | None:
    """Metric-gated lossy bytes for one image. None — keep the lossless path."""
    if Image is None or not have_ffmpeg() or not img.raw:
        return None
    marked = _lossy_mark(img.attrs or "")
    if marked is not None and target >= marked:
        return None  # already lossy at this (or gentler) target: never ratchet
    im = _pil_open(img.raw)
    if im is None:
        return None
    if img.kind == "jpg":
        return _lossy_jpeg(im, img, workdir, target, True, base_cost)
    if img.kind == "png":
        return _lossy_png(im, img, workdir, target, True, base_cost)
    return None


def _try_lossy(img: _Image, workdir: str, target: float, base: bytes,
               marks: list[int] | None = None) -> bytes:
    """Replace base with a lossy variant only when strictly smaller and valid."""
    if not base or len(img.raw) < LOSSY_MIN_BYTES:
        return base
    base_cost = _packed_cost(base)
    variant = _lossy_variant(img, workdir, target, base_cost)
    if variant is None:
        return base
    vbytes, vsize = variant
    if not vbytes.startswith((PNG_MAGIC, JPEG_MAGIC)):
        return base
    vkind = "png" if vbytes.startswith(PNG_MAGIC) else "jpg"
    if not 0 < _packed_cost(vbytes) < base_cost and not (
            vkind == "png" and len(vbytes) < ECT_FAST_BYTES):
        return base
    # Squeeze the lossy bytes through the same lossless pass.
    ltmp = os.path.join(workdir, f"lossy_{img.idx:04d}.{vkind}")
    try:
        with open(ltmp, "wb") as fh:
            fh.write(vbytes)
    except OSError:
        return base
    try:
        _ect_squeeze(ltmp, vkind)
        try:
            with open(ltmp, "rb") as fh:
                eco = fh.read()
        except OSError:
            return base
        if not 0 < _packed_cost(eco) < base_cost:
            return base
        if not _looks_complete(vkind, eco):
            return base
        if not _same_dims(eco, vsize):
            return base
        if marks is not None:
            marks.append(img.idx)
        return eco
    finally:
        try:
            os.unlink(ltmp)
        except OSError:
            pass


# Optimizing one FB2 document (in memory)
# --------------------------------------------------------------------------

def optimize_fb2_payload(payload: bytes, workdir: str,
                         have_ect: bool, lossy: float | None = None,
                         img_workers: int = 1
                         ) -> tuple[bytes, Fb2Stats]:
    """Optimize the bytes of one .fb2. Returns (new_bytes, stats).

    The breakdown is exact at unpacked-FB2 level:
      png/jpg/other — base64 body delta of images of that type;
      xml — the rest of the total delta (comments, gaps between tags).
    The breakdown sums to the unpacked FB2 delta.
    """
    if payload is None:
        raise Fb2OptError("empty FB2 data")
    text, encoding = decode_fb2_payload(payload)
    matches = list(_binary_matches(text))

    images: list[_Image] = []
    skeleton_parts: list[str] = []
    skipped = 0
    token = uuid.uuid4().hex  # unique per document: literal text can never collide
    last = 0
    for idx, match in enumerate(matches):
        attrs, body = match.group(1), match.group(2)
        id_match = ID_RE.search(attrs or "")
        if not id_match:
            skipped += 1
            continue  # block without id — leave fully alone
        raw = decode_body(body)
        if raw is None:
            skipped += 1
            continue  # broken base64 — keep the block as is
        img_id = id_match.group(1)
        kind = detect_kind(raw, attrs or "")
        images.append(_Image(idx=idx, img_id=img_id, kind=kind,
                             raw=raw, orig_b64_len=len(body), attrs=attrs,
                             orig_body=body))
        placeholder = f"__FB2OPT_{token}_{idx}__"
        skeleton_parts.append(text[last:match.start()])
        skeleton_parts.append(f"<binary{attrs}>{placeholder}</binary>")
        last = match.end()
    skeleton_parts.append(text[last:])
    skeleton = "".join(skeleton_parts)

    # Project known marks (program-used token + legacy tag attrs) into
    # images, so the variant skip and the shield counter work unchanged.
    # Output tags are rewritten from real attrs plus a single token.
    real_attrs = {img.idx: img.attrs for img in images}
    known, present_ids = _project_lossy_marks(text, images, lossy)

    lossy_marks: list[int] = []
    optimized = optimize_images(images, workdir, have_ect, lossy,
                                lossy_marks, img_workers)

    stats = Fb2Stats(pics=len(images), skipped=skipped)
    blocks: dict[int, str] = {}
    skeleton_late: list[tuple[str, str]] = []  # (img_id, final_attrs)
    mark_set = set(lossy_marks)
    kind_stripped = 0
    for img in images:
        final = optimized.get(img.idx, img.raw)
        if final == img.raw:
            # The skeleton already holds the tags around the placeholder: swap the body only.
            # Original body = byte-exact same block, delta 0.
            blocks[img.idx] = img.orig_body
            if lossy is not None:
                marked = _lossy_mark(img.attrs or "")
                if marked is not None and lossy >= marked:
                    stats.marked += 1
            continue
        # Single-line bodies everywhere; the counter compares against the
        # flattened original, so wrapping style never leaks into numbers.
        new_body = encode_body(final)
        blocks[img.idx] = new_body
        final_kind = detect_kind(final, "")
        raw_attrs = real_attrs[img.idx]
        # Legacy marks leave the tags only under --lossy (migration);
        # default mode never rewrites user markup beyond content-type.
        attrs = (_strip_mark_from_attrs(raw_attrs) if lossy is not None
                 else raw_attrs)
        kind_stripped += len(raw_attrs) - len(attrs)
        if final_kind in ("png", "jpg") and final_kind != img.kind:
            attrs = _set_content_type(attrs, final_kind)
        if attrs != raw_attrs:
            skeleton_late.append((img.img_id, attrs))
        delta = _flat_b64_len(img.raw) - len(new_body)
        if img.kind == "png":
            stats.png_saved += delta
        elif img.kind == "jpg":
            stats.jpg_saved += delta
        else:
            stats.other_saved += delta

    for img_id, attrs in skeleton_late:
        skeleton = _patch_binary_attrs(skeleton, img_id, attrs)
    old_ann = new_ann = 0
    if lossy is not None:
        skeleton, old_ann, new_ann, reopened = _write_lossy_token(
            skeleton, known, present_ids, images, mark_set, lossy,
            real_attrs)
        stats.reopened += reopened
        old_ann += kind_stripped
    stats.marks = old_ann - new_ann
    new_skeleton = minify_skeleton(skeleton)
    for img in images:
        new_skeleton = new_skeleton.replace(f"__FB2OPT_{token}_{img.idx}__",
                                            blocks[img.idx], 1)
    try:
        new_payload = new_skeleton.encode(encoding)
    except (UnicodeEncodeError, LookupError) as exc:
        raise Fb2OptError(f"failed to encode the result ({encoding}): {exc}") from exc

    total_delta = len(payload) - len(new_payload)
    img_delta = stats.png_saved + stats.jpg_saved + stats.other_saved
    stats.xml_saved = total_delta - img_delta - stats.marks
    return new_payload, stats


# --------------------------------------------------------------------------
# Writing the result under the "replace only if smaller" rule
# --------------------------------------------------------------------------

def _clone_info(info: zipfile.ZipInfo, compress_type: int | None = None
                ) -> zipfile.ZipInfo:
    """Copy a ZipInfo, optionally overriding the compression method."""
    ni = zipfile.ZipInfo(filename=info.filename, date_time=info.date_time)
    ni.compress_type = info.compress_type if compress_type is None else compress_type
    ni.comment = info.comment
    ni.extra = info.extra
    ni.internal_attr = info.internal_attr
    ni.external_attr = info.external_attr
    ni.create_system = info.create_system
    ni.create_version = info.create_version
    ni.extract_version = info.extract_version
    ni.flag_bits = info.flag_bits
    ni.volume = info.volume
    return ni


def _drop_tmp(tmp_path: str, registry: list[str]) -> None:
    """Remove a temp file and forget it. Never raises.

    Safety rail: only candidates created by _write_candidate
    (".fb2opt-*.zip" next to the target) are ever deleted here,
    so a book can never be removed through this path by mistake.
    """
    if not isinstance(tmp_path, str) or not os.path.basename(tmp_path).startswith(".fb2opt-"):
        _reg_forget(registry, tmp_path)
        print(f"[warning] refusing to delete a non-temp file: {tmp_path}",
              file=sys.stderr)
        return
    try:
        os.unlink(tmp_path)
    except OSError:
        pass
    _reg_forget(registry, tmp_path)


def _find_vanished(before: dict[str, bool]) -> list[str]:
    """Return input paths that existed before the batch but are gone now."""
    if not before:
        return []
    return [path for path, existed in before.items()
            if existed and not os.path.lexists(path)]


def _sweep_temps(registry: list[str]) -> None:
    """Best-effort cleanup of leftover temp files (e.g. after Ctrl+C)."""
    for tmp_path in list(registry):
        _drop_tmp(tmp_path, registry)


def _umask() -> int:
    """Current umask without changing it (thread-safe, computed once)."""
    global _CACHED_UMASK
    if _CACHED_UMASK is not None:
        return _CACHED_UMASK
    with _UMASK_LOCK:
        if _CACHED_UMASK is not None:
            return _CACHED_UMASK
        try:
            mask = os.umask(0)
        except OSError:
            return 0o022
        try:
            os.umask(mask)
        except OSError:
            pass
        _CACHED_UMASK = mask
        return mask


def _reg_append(registry: list[str], path: str) -> None:
    """Thread-safe registry append. Never raises."""
    try:
        with _REGISTRY_LOCK:
            registry.append(path)
    except Exception:
        pass


def _reg_forget(registry: list[str], path: str) -> None:
    """Thread-safe registry remove. Never raises."""
    try:
        with _REGISTRY_LOCK:
            try:
                registry.remove(path)
            except ValueError:
                pass
    except Exception:
        pass


def _fresh_info(arcname: str, src_path: str) -> zipfile.ZipInfo:
    """ZipInfo for a freshly packed file: source mtime, sane permissions."""
    try:
        mtime = os.path.getmtime(src_path)
    except OSError:
        mtime = time.time()
    info = zipfile.ZipInfo(filename=arcname, date_time=time.localtime(mtime)[:6])
    info.compress_type = zipfile.ZIP_DEFLATED
    info.external_attr = (0o644 & ~_umask()) << 16
    return info


def _write_candidate(entries: list[tuple[zipfile.ZipInfo, bytes]],
                     archive_comment: bytes, base_dir: str,
                     have_ect: bool, registry: list[str]) -> str:
    """Repack entries into a temp ZIP next to the target. Returns its path."""
    try:
        handle, tmp_path = tempfile.mkstemp(dir=base_dir, prefix=".fb2opt-",
                                            suffix=".zip")
        os.close(handle)
    except OSError as exc:
        raise Fb2OptError(f"no write access to {base_dir}: {exc}") from exc
    _reg_append(registry, tmp_path)
    try:
        with zipfile.ZipFile(tmp_path, "w", zipfile.ZIP_DEFLATED,
                              compresslevel=9) as zout:
            for info, data in entries:
                zout.writestr(info, data)
            zout.comment = archive_comment
    except OSError as exc:
        _drop_tmp(tmp_path, registry)
        raise Fb2OptError(f"failed to pack: {exc}") from exc
    # ect -zip strips comments, so they are restored afterwards: the archive
    # comment via zipfile, member comments via central-directory surgery.
    if have_ect:
        member_comments = {info.filename: (info.comment or b"")
                           for info, _ in entries}
        run_tool(["ect", "-9", "-zip", tmp_path])
        _verify_candidate(tmp_path, [info.filename for info, _ in entries],
                          registry)
        if any(member_comments.values()) and not _restore_member_comments(
                tmp_path, member_comments):
            _drop_tmp(tmp_path, registry)
            raise Fb2OptError("failed to restore ZIP member comments, "
                              "kept original")
        _verify_candidate(tmp_path, [info.filename for info, _ in entries],
                          registry)
    if archive_comment:
        try:
            with zipfile.ZipFile(tmp_path, "a") as zfix:
                zfix.comment = archive_comment
        except OSError:
            pass
    return tmp_path


def _restore_member_comments(tmp_path: str, comments: dict[str, bytes]) -> bool:
    """Put ZIP member comments back after an optimizer stripped them.

    Rewrites only the central directory (local file data — the ect
    compression — is untouched). Returns False on anything unexpected
    (multi-disk, ZIP64); the caller then keeps the original.
    """
    if not tmp_path or not comments or not any(comments.values()):
        return True
    try:
        if os.path.getsize(tmp_path) > MAX_ARCHIVE_BYTES:
            return False
    except OSError:
        return False
    try:
        with open(tmp_path, "rb") as fh:
            blob = fh.read()
    except OSError:
        return False
    eocd_pos = blob.rfind(b"PK\x05\x06")
    if eocd_pos < 0 or len(blob) < eocd_pos + 22:
        return False
    try:
        disk, cd_disk, n_here, n_total, cd_size, cd_off, _arc = struct.unpack(
            "<HHHHIIH", blob[eocd_pos + 4:eocd_pos + 22])
    except struct.error:
        return False
    if disk != 0 or cd_disk != 0 or n_here != n_total:
        return False
    if cd_off + cd_size != eocd_pos:
        return False
    end = eocd_pos
    pos = cd_off
    out = bytearray()
    while pos < end:
        if blob[pos:pos + 4] != b"PK\x01\x02" or pos + 46 > end:
            return False
        try:
            name_len, extra_len, com_len = struct.unpack(
                "<HHH", blob[pos + 28:pos + 34])
        except struct.error:
            return False
        head = blob[pos:pos + 46]
        name = blob[pos + 46:pos + 46 + name_len]
        extra = blob[pos + 46 + name_len:pos + 46 + name_len + extra_len]
        tail = pos + 46 + name_len + extra_len + com_len
        if tail > end:
            return False
        try:
            fname = name.decode("utf-8")
        except UnicodeDecodeError:
            try:
                fname = name.decode("cp437")
            except UnicodeDecodeError:
                return False
        new_com = comments.get(fname, b"") or b""
        out += head[:32] + struct.pack("<H", len(new_com)) + head[34:]
        out += name + extra + new_com
        pos = tail
    if pos != end:
        return False
    new_cd = bytes(out)
    new_eocd = struct.pack("<IHHHHIIH", 0x06054B50, 0, 0,
                           n_total, n_total, len(new_cd), cd_off, 0)
    try:
        with open(tmp_path, "wb") as fh:
            fh.write(blob[:cd_off] + new_cd + new_eocd)
    except OSError:
        return False
    return True


def _verify_candidate(tmp_path: str, expected_names: list[str],
                      registry: list[str]) -> None:
    """Check the archive an external optimizer just touched.

    A broken/truncated candidate must never replace the original.
    """
    try:
        with zipfile.ZipFile(tmp_path, "r") as check:
            bad = check.testzip()
            names = check.namelist()
    except zipfile.BadZipFile as exc:
        _drop_tmp(tmp_path, registry)
        raise Fb2OptError(f"optimizer broke the archive, kept original: {exc}") from exc
    if bad is not None or sorted(names) != sorted(expected_names):
        _drop_tmp(tmp_path, registry)
        raise Fb2OptError(f"optimizer broke the archive (bad member: {bad}), "
                          f"kept original")


def _warn_skipped(name: str, stats: Fb2Stats) -> None:
    """Report binary blocks that were left alone (stderr, result line untouched)."""
    if stats.skipped:
        print(f"[warning] {name}: skipped {stats.skipped} bad <binary> blocks "
              f"(no id or broken base64)", file=sys.stderr)
    if stats.marked:
        print(f"[info] {name}: {stats.marked} images already lossy-stamped, "
              f"left untouched (re-run --lossy only bites with a lower target)",
              file=sys.stderr)
    if stats.reopened:
        print(f"[info] {name}: {stats.reopened} images re-opened "
              f"at a stricter target — quality is measured against "
              f"the already-lossy pixels, not the original",
              file=sys.stderr)


def _place_if_smaller(tmp_path: str, final_path: str, old_size: int,
                       registry: list[str]) -> tuple[bool, int]:
    """Atomically swap final_path with a temp file, only if it is smaller.

    Returns (replaced, new_size). The temp file always goes away:
    it either moves into place or is deleted.
    """
    if not os.path.isfile(tmp_path):
        raise Fb2OptError("temp file is gone")
    new_size = os.path.getsize(tmp_path)
    if new_size <= 0:
        _drop_tmp(tmp_path, registry)
        raise Fb2OptError("refusing to install an empty file, kept original")
    saved = old_size - new_size
    if saved <= 0:
        _drop_tmp(tmp_path, registry)
        return False, new_size
    try:
        if os.path.exists(final_path):
            shutil.copymode(final_path, tmp_path)
        os.replace(tmp_path, final_path)
    except OSError as exc:
        _drop_tmp(tmp_path, registry)
        raise Fb2OptError(f"failed to write the result: {exc}") from exc
    try:
        actual = os.path.getsize(final_path)
    except OSError as exc:
        raise Fb2OptError(f"result vanished right after install: {exc}") from exc
    if actual != new_size:
        raise Fb2OptError(f"result size mismatch after install "
                          f"(expected {new_size}, got {actual})")
    _reg_forget(registry, tmp_path)
    return True, new_size


def optimize_zip_file(path: str, tmp_root: str, have_ect: bool,
                       registry: list[str], lossy: float | None = None,
                       img_workers: int = 1
                       ) -> tuple[int, str]:
    """Optimize a .zip archive in place (when it pays off). Returns (saved, line)."""
    if not os.path.isfile(path):
        raise Fb2OptError("file not found")
    name = os.path.basename(path)
    try:
        old_size = os.path.getsize(path)
    except OSError as exc:
        raise Fb2OptError(f"failed to read the size: {exc}") from exc
    try:
        with zipfile.ZipFile(path, "r") as zin:
            archive_comment = zin.comment
            _infos = zin.infolist()
            if len(_infos) > MAX_ARCHIVE_MEMBERS:
                raise Fb2OptError(f"too many archive members ({len(_infos)})")
            _total = 0
            for _info in _infos:
                try:
                    _sz = _info.file_size
                except AttributeError:
                    _sz = 0
                if _sz > MAX_MEMBER_BYTES:
                    raise Fb2OptError(f"archive member too large ({_info.filename})")
                _total += _sz
                if _total > MAX_ARCHIVE_BYTES:
                    raise Fb2OptError("archive too large")
            members = [(info, zin.read(info.filename)) for info in _infos]
    except zipfile.BadZipFile as exc:
        raise Fb2OptError(f"broken ZIP: {exc}") from exc
    except OSError as exc:
        raise Fb2OptError(f"failed to unpack: {exc}") from exc

    img_workdir = os.path.join(tmp_root, "img")
    stats = Fb2Stats()
    entries: list[tuple[zipfile.ZipInfo, bytes]] = []
    fb2_count = 0
    for info, data in members:
        if info.is_dir():
            entries.append((_clone_info(info), data))
            continue
        if info.filename.lower().endswith(".fb2"):
            try:
                new_data, member_stats = optimize_fb2_payload(
                    data, img_workdir, have_ect, lossy, img_workers)
            except Fb2OptError as exc:
                raise Fb2OptError(f"{info.filename}: {exc}") from exc
            stats.add(member_stats)
            fb2_count += 1
            entries.append((_clone_info(info, zipfile.ZIP_DEFLATED), new_data))
        else:
            entries.append((_clone_info(info), data))  # foreign files — byte for byte
    if fb2_count == 0:
        raise Fb2OptError("no .fb2 in the archive")

    base_dir = os.path.dirname(os.path.abspath(path))
    tmp_path = _write_candidate(entries, archive_comment, base_dir,
                                have_ect, registry)

    replaced, _ = _place_if_smaller(tmp_path, os.path.abspath(path), old_size,
                                    registry)
    _warn_skipped(name, stats)
    if not replaced:
        return 0, f"{name}: already optimal"
    saved = old_size - os.path.getsize(os.path.abspath(path))
    return saved, f"{name}: saved {saved} bytes ({stats.breakdown()})"


def optimize_fb2_file(path: str, tmp_root: str, have_ect: bool,
                       registry: list[str], lossy: float | None = None,
                       img_workers: int = 1
                       ) -> tuple[int, str]:
    """Pack a raw .fb2 into a sibling .fb2.zip (under the "write only if smaller" rule)."""
    if not os.path.isfile(path):
        raise Fb2OptError("file not found")
    name = os.path.basename(path)
    abs_path = os.path.abspath(path)
    try:
        with open(abs_path, "rb") as fh:
            payload = fh.read()
    except OSError as exc:
        raise Fb2OptError(f"failed to read: {exc}") from exc

    img_workdir = os.path.join(tmp_root, "img")
    new_payload, stats = optimize_fb2_payload(payload, img_workdir, have_ect,
                                               lossy, img_workers)

    target = abs_path + ".zip"
    entries = [(_fresh_info(os.path.basename(abs_path), abs_path), new_payload)]
    tmp_path = _write_candidate(entries, b"", os.path.dirname(abs_path),
                                have_ect, registry)
    try:
        os.chmod(tmp_path, 0o666 & ~_umask())  # fresh files: normal perms, not 0600
    except OSError:
        pass

    try:
        new_size = os.path.getsize(tmp_path)
    except OSError as exc:
        _drop_tmp(tmp_path, registry)
        raise Fb2OptError(f"temp file is gone: {exc}") from exc

    if os.path.exists(target):
        try:
            old_size = os.path.getsize(target)
        except OSError as exc:
            _drop_tmp(tmp_path, registry)
            raise Fb2OptError(f"failed to read {target}: {exc}") from exc
        replaced, _ = _place_if_smaller(tmp_path, target, old_size, registry)
        _warn_skipped(name, stats)
        if not replaced:
            return 0, f"{name}: already optimal"
        return old_size - new_size, (f"{name}: saved {old_size - new_size} bytes "
                                     f"({stats.breakdown()})")

    old_size = len(payload)
    if new_size >= old_size:
        _drop_tmp(tmp_path, registry)
        _warn_skipped(name, stats)
        return 0, (f"{name}: saved 0 bytes "
                   f"(compressed copy is bigger, not created)")
    try:
        os.replace(tmp_path, target)
    except OSError as exc:
        _drop_tmp(tmp_path, registry)
        raise Fb2OptError(f"failed to write {target}: {exc}") from exc
    _reg_forget(registry, tmp_path)
    _warn_skipped(name, stats)
    return old_size - new_size, (f"{name}: saved {old_size - new_size} bytes "
                                 f"({stats.breakdown()}) → {os.path.basename(target)}")


def _optimize_one(path: str, tmp_root: str, have_ect: bool,
                   registry: list[str], lossy: float | None = None,
                   img_workers: int = 1
                   ) -> tuple[int, str]:
    """Optimize a single file; errors come as Fb2OptError."""
    if not isinstance(path, str) or not path:
        raise Fb2OptError("empty file name")
    if os.path.islink(path):
        return 0, f"{os.path.basename(path)}: skipped (symlink, left untouched)"
    if os.path.isdir(path):
        raise Fb2OptError("is a directory (use -r to walk it)")
    lowered = path.lower()
    per_file_tmp = tempfile.mkdtemp(dir=tmp_root)
    if lowered.endswith(".zip"):
        return optimize_zip_file(path, per_file_tmp, have_ect, registry,
                                 lossy, img_workers)
    if lowered.endswith(".fb2"):
        return optimize_fb2_file(path, per_file_tmp, have_ect, registry,
                                 lossy, img_workers)
    raise Fb2OptError("need .fb2 or .zip")


# --------------------------------------------------------------------------
# --extract mode
# --------------------------------------------------------------------------

def _iter_fb2_payloads(sources: list[str]):
    """Yield (source_name, book_name, fb2_bytes) from files/folders."""
    if not sources:
        return
    for src in sources:
        if not isinstance(src, str) or not src or not os.path.exists(src):
            print(f"[error] source not found: {src}", file=sys.stderr)
            continue
        if os.path.isdir(src):
            for root, _, files in os.walk(src, followlinks=False):
                for fn in sorted(files):
                    if fn.lower().endswith((".fb2", ".zip")):
                        yield from _payloads_from_file(os.path.join(root, fn))
        else:
            yield from _payloads_from_file(src)


def _payloads_from_file(path: str):
    """FB2 bytes from one file (.fb2 directly, .zip — every nested .fb2)."""
    lowered = path.lower()
    if lowered.endswith(".fb2"):
        try:
            with open(path, "rb") as fh:
                yield path, os.path.basename(path), fh.read()
        except OSError as exc:
            print(f"[error] {path}: cannot read: {exc}", file=sys.stderr)
        return
    if lowered.endswith(".zip"):
        try:
            with zipfile.ZipFile(path, "r") as zin:
                members = [(info.filename, zin.read(info.filename))
                           for info in zin.infolist()
                           if not info.is_dir() and info.filename.lower().endswith(".fb2")]
        except Exception as exc:
            print(f"[error] {path}: {type(exc).__name__}: {exc}", file=sys.stderr)
            return
        if not members:
            print(f"[info] {path}: no .fb2 in the archive", file=sys.stderr)
        for member_name, data in members:
            yield path, member_name, data
        return
    print(f"[error] {path}: need .fb2, .zip or a folder", file=sys.stderr)


def cmd_extract(sources: list[str], out_dir: str, quiet: bool) -> int:
    """Pull all images out of books into a folder. Returns the exit code."""
    if not sources:
        print("[error] --extract: give a file or a folder", file=sys.stderr)
        return 2
    if not out_dir:
        print("[error] --extract: empty --dir", file=sys.stderr)
        return 2
    try:
        os.makedirs(out_dir, exist_ok=True)
    except OSError as exc:
        print(f"[error] folder {out_dir} not created: {exc}", file=sys.stderr)
        return 1
    count = 0
    for src_path, book_name, payload in _iter_fb2_payloads(sources):
        try:
            text, _ = decode_fb2_payload(payload)
        except Fb2OptError as exc:
            print(f"[error] {src_path}: {exc}", file=sys.stderr)
            continue
        for match in _binary_matches(text):
            attrs, body = match.group(1), match.group(2)
            id_match = ID_RE.search(attrs or "")
            raw = decode_body(body)
            if raw is None:
                continue
            kind = detect_kind(raw, attrs or "")
            ext = {"png": "png", "jpg": "jpg", "gif": "gif"}.get(kind, "bin")
            base = sanitize_filename(id_match.group(1)) if id_match else f"img_{count}"
            stem, cur_ext = os.path.splitext(base)
            fname = base if cur_ext.lower() == f".{ext}" else f"{stem or base}.{ext}"
            dest = unique_path(os.path.join(out_dir, fname))
            try:
                with open(dest, "wb") as fh:
                    fh.write(raw)
            except OSError as exc:
                print(f"[error] {dest}: not written: {exc}", file=sys.stderr)
                continue
            count += 1
            if not quiet:
                print(f"  -> {os.path.basename(dest)} (from {book_name})")
    if not quiet:
        print(f"[done] images pulled: {count} → {out_dir}")
    return 0


